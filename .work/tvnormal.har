low: hidden;\r\n\r\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);\r\n  }\r\n\r\n  /* =========================\r\n     INVISIBLE AUTO-CLOSE\r\n     Tidak terlihat dan tidak\r\n     bisa diklik user\r\n  ========================= */\r\n\r\n  .invisible-close {\r\n    position: absolute;\r\n\r\n    width: 1px;\r\n    height: 1px;\r\n\r\n    padding: 0;\r\n    margin: -1px;\r\n\r\n    overflow: hidden;\r\n\r\n    clip: rect(0, 0, 0, 0);\r\n    clip-path: inset(50%);\r\n\r\n    white-space: nowrap;\r\n\r\n    border: 0;\r\n\r\n    opacity: 0;\r\n\r\n    pointer-events: none;\r\n\r\n    z-index: -1;\r\n  }\r\n\r\n  /* =========================\r\n     CONTENT\r\n  ========================= */\r\n\r\n  .content {\r\n    position: absolute;\r\n    bottom: 95px;\r\n    left: 75%;\r\n\r\n    transform: translateX(-50%);\r\n\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n\r\n    color: white;\r\n  }\r\n\r\n  /* =========================\r\n     COUNTDOWN\r\n  ========================= */\r\n\r\n  .counters {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n\r\n    margin: 0;\r\n  }\r\n\r\n  .counter {\r\n    position: relative;\r\n    margin: 0 12px;\r\n  }\r\n\r\n  .counter + .counter::before {\r\n    content: \":\";\r\n\r\n    position: absolute;\r\n    left: -16px;\r\n    top: 8px;\r\n\r\n    color: #fff;\r\n    font-size: 26px;\r\n    font-weight: bold;\r\n  }\r\n\r\n  .counter-window {\r\n    width: 45px;\r\n    height: 45px;\r\n\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    background: rgba(15, 15, 15, 0.1);\r\n\r\n    border-radius: 8px;\r\n\r\n    color: #fff;\r\n\r\n    font-size: 22px;\r\n    font-weight: 450;\r\n  }\r\n\r\n  .counter-label {\r\n    margin-top: 6px;\r\n\r\n    color: #ddd;\r\n\r\n    font-size: 13px;\r\n  }\r\n\r\n  /* =========================\r\n     BUTTON\r\n  ========================= */\r\n\r\n  .buttons {\r\n    display: flex;\r\n    justify-content: center;\r\n\r\n    gap: 20px;\r\n\r\n    margin-top: 25px;\r\n    margin-bottom: -35px;\r\n  }\r\n\r\n  .focusable-button {\r\n    display: block;\r\n\r\n    padding: 16px 36px;\r\n\r\n    border: none;\r\n    border-radius: 44px;\r\n\r\n    background-color: #323232;\r\n\r\n    color: #cccccc;\r\n\r\n    font-size: 1.2rem;\r\n\r\n    cursor: pointer;\r\n\r\n    text-decoration: none;\r\n  }\r\n\r\n  .focusable-button:hover {\r\n    background-color: #ffffff;\r\n    color: #383838;\r\n  }\r\n</style>\r\n<div class=\"container\"><!--\r\n    Invisible close element.\r\n    Tidak terlihat dan tidak bisa diklik user.\r\n    JavaScript akan melakukan click()\r\n    ketika countdown selesai.\r\n  --> <button type=\"button\" class=\"invisible-close\" data-dismiss=\"true\" aria-hidden=\"true\" tabindex=\"-1\"></button> <!-- =========================\r\n       CONTENT\r\n  ========================== -->\r\n<div class=\"content\"><!-- COUNTDOWN -->\r\n<div class=\"counters\">\r\n<div class=\"counter\">\r\n<div class=\"counter-window\" id=\"hours\">00</div>\r\n<div class=\"counter-label\">Jam</div>\r\n</div>\r\n<div class=\"counter\">\r\n<div class=\"counter-window\" id=\"minutes\">00</div>\r\n<div class=\"counter-label\">Menit</div>\r\n</div>\r\n<div class=\"counter\">\r\n<div class=\"counter-window\" id=\"seconds\">30</div>\r\n<div class=\"counter-label\">Detik</div>\r\n</div>\r\n</div>\r\n<!-- =========================\r\n         CTA\r\n    ========================== -->\r\n<div class=\"buttons\"><a href=\"https://www.vidio.com/purchases?itm=product-bd&amp;voucher_code=OEMPLTAG90D&amp;product_catalog_id=1751&amp;itm_source=product-bd&amp;itm_medium=in-app-banner&amp;itm_campaign=oem-asian-games-2026\" class=\"focusable-button\" target=\"_self\"> Ambil Promo </a></div>\r\n</div>\r\n</div>\r\n<!-- =========================\r\n     JAVASCRIPT\r\n========================== -->\r\n<p>\r\n<script>\r\n  function closeInApp() {\r\n    const closeButton = document.querySelector(\r\n      '[data-dismiss=\"true\"]'\r\n    );\r\n\r\n    if (closeButton) {\r\n      closeButton.click();\r\n    }\r\n  }\r\n\r\n\r\n  function startCountdown(duration) {\r\n    let timer = duration;\r\n\r\n    const hoursElement =\r\n      document.getElementById(\"hours\");\r\n\r\n    const minutesElement =\r\n      document.getElementById(\"minutes\");\r\n\r\n    const secondsElement =\r\n      document.getElementById(\"seconds\");\r\n\r\n\r\n    function updateCountdown() {\r\n      const hours =\r\n        Math.floor(timer / 3600);\r\n\r\n      const minutes =\r\n        Math.floor((timer % 3600) / 60);\r\n\r\n      const seconds =\r\n        timer % 60;\r\n\r\n\r\n      hoursElement.textContent =\r\n        String(hours).padStart(2, \"0\");\r\n\r\n      minutesElement.textContent =\r\n        String(minutes).padStart(2, \"0\");\r\n\r\n      secondsElement.textContent =\r\n        String(seconds).padStart(2, \"0\");\r\n\r\n\r\n      /*\r\n        Ketika countdown mencapai 00:00:00,\r\n        auto-close In-App.\r\n      */\r\n\r\n      if (timer <= 0) {\r\n        clearInterval(countdownInterval);\r\n\r\n        setTimeout(() => {\r\n          closeInApp();\r\n        }, 100);\r\n\r\n        return;\r\n      }\r\n\r\n\r\n      timer--;\r\n    }\r\n\r\n\r\n    // Jalankan langsung supaya\r\n    // tidak menunggu 1 detik pertama.\r\n    updateCountdown();\r\n\r\n\r\n    const countdownInterval =\r\n      setInterval(updateCountdown, 1000);\r\n  }\r\n\r\n\r\n  /* =========================\r\n     SET COUNTDOWN DI SINI\r\n  ==========================\r\n\r\n     30 detik  = 30\r\n     1 menit   = 60\r\n     5 menit   = 300\r\n     10 menit  = 600\r\n  */\r\n\r\n  startCountdown(300);\r\n</script>\r\n</p><script src=\"https://static-quiz.prod.vidiocdn.com/assets/js/messaging_campaign-64081e4d3486ebe03a6b202d1bd8f59b16e1d18561672e8b993e2202e652d024.js\"></script><script>window.addEventListener(\"load\", function(event) {\n  window.MessagingCampaign.IS_AHOY_SCRIPT_INCLUDED = false;\n  window.MessagingCampaign.init();\n  console.log(\"MessagingCampaign initialized!\");\n});</script></body></html>"},"redirectURL":"","headersSize":781,"bodySize":2457,"_status":"completed","_startTimestamp":1789914614648888,"_endTimestamp":1789914614657273},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"172.66.144.39","connection":"30","comment":"","_id":59,"_uid":"ce2f6869-e1e5-42df-b032-a3ca823c9281","_cid":30,"_ctime":1789914614000,"_sid":1,"_stime":1789914614000,"_serverAddress":"172.66.144.39","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":51816,"_app":{"name":"Vidio","id":"com.vidio.android.tv"}},{"startedDateTime":"2026-09-20T14:30:11.992Z","time":241,"request":{"method":"GET","url":"https://thumbor.prod.vidiocdn.com/MfNRfDbMtKRkP4n-IbrqXGpbzK0=/944x416/filters:quality(80)/vidio-web-prod-headline/uploads/headline/image/40505/reelshort-general-f4de9b.png","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"thumbor.prod.vidiocdn.com"},{"name":":path","value":"/MfNRfDbMtKRkP4n-IbrqXGpbzK0=/944x416/filters:quality(80)/vidio-web-prod-headline/uploads/headline/image/40505/reelshort-general-f4de9b.png"},{"name":":scheme","value":"https"},{"name":"accept-encoding","value":"gzip"},{"name":"user-agent","value":"okhttp/4.12.0"}],"queryString":[],"headersSize":267,"bodySize":0,"_status":"completed","_startTimestamp":1789914611992938,"_endTimestamp":1789914611995708},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"200"},{"name":"server","value":"nginx"},{"name":"content-length","value":"62527"},{"name":"access-control-allow-origin","value":"*"},{"name":"access-control-allow-methods","value":"GET, OPTIONS"},{"name":"access-control-allow-headers","value":"Authorization, Content-Type"},{"name":"x-envoy-upstream-servi