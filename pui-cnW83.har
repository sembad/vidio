rkan pada 21 Agustus 2022. MOJI memfokuskan diri sebagai \\u0026quot;Surga Tontonan bagi Pemirsa Olahraga dan Anak Muda\\u0026quot;. MOJI menayangkan berbagai kompetisi voli domestik dan internasional seperti FIVB, Sea V League, One Championship, dan program olahraga unggulan lainnya. Selain itu, terdapat program gaya hidup dan infotainment yang dinamis. \\u003c/p\\u003e\\u003cp\\u003eJadikan setiap hari lebih seru dengan menyaksikan Moji secara Live Streaming maupun Catch-up hanya di Vidio.\\u003c/p\\u003e\",\"comment_count\":0,\"comments_count\":0,\"total_plays\":0}],\"users\":[{\"id\":187464,\"name\":\"Moji\",\"username\":\"moji\",\"description\":\"MOJI sebagai saluran televisi yang bernaung di bawah EMTEK Group dengan fokus kepada segmentasi program anak muda dan olahraga yang mengudara pada Minggu, 21 Agustus 2022.\\r\\n\\r\\nNama MOJI sendiri terinspirasi dari kata 'emoji' dua kata dari bahasa Jepang yang mengartikan, “picture” dan moji adalah “character”. Denga tagline “Everyday Excitement”, MOJI hadir menyapa pemirsa sebagai televisi yang membuka wajah baru dengan kegembiraan \\u0026 inspirasi baru melalui tayangan program hiburan serta gaya hidup kaum muda dan program olahraga nasional hingga internasional. Kehadiran MOJI diharapkan dapat menjadi representasi karakter dari televisi anak muda masa kini dan penggemar olah raga pada umumnya.\",\"verified_ugc\":true,\"woi_avatar_url\":\"https://thumbor.prod.vidiocdn.com/Ay-_wCnctPw8iOGkBvayNJhFSEs=/144x144/smart/filters:strip_icc():quality(70)/vidio-web-prod-user/uploads/user/avatar/187464/3214539359687555207644262388482534864682393n-eeafa9fe29daae82.jpg\",\"cover_url\":\"https://thumbor.prod.vidiocdn.com/TufMkVtr2f85yuh4N59q_W51Op4=/1000x310/filters:quality(70)/vidio-web-prod-user/uploads/user/cover/187464/bannermoji-21faa782f163546e.jpg\",\"default_avatar\":false,\"default_cover\":false,\"last_sign_in_at\":\"2026-09-11T15:51:32.351Z\",\"current_sign_in_at\":\"2026-09-11T15:51:32.351Z\",\"follower_count\":57,\"following_count\":0,\"channels_count\":15,\"total_videos_published\":4755,\"is_following\":false}],\"livestreamings_concurrent\":[{\"id\":206,\"total_concurrent_users\":1308}],\"ads\":{\"enable_custom_skip_ad_button\":true,\"android\":{\"ads_params\":{},\"below_player\":\"\"},\"ios\":{\"ads_params\":{}},\"tag_uri\":\"https://hermes.vidio.com/api/tags?ce=\\u0026cg=\\u0026cp=false\\u0026ct=Livestreaming\\u0026cct\\u0026cgp=Entertainment%2CSports%20%3E%20Volleyball%20%3E%20AVC%20Men%27s%20Nation%20Cup\\u0026cid=206\\u0026cmg=\\u0026cro=\\u0026cur=internal_partner\\u0026cuu=moji\\u0026cuid=187464\\u0026durl=https%3A%2F%2Fwww.vidio.com%2Flive%2F206-moji\\u0026fld=false\\u0026lst=entertainment%2Cindonesia%20entertainmen%20produksi%2Cochannel%2Co%20channel%2Cnon%20kids\\u0026cti=Chinese%20Taipei%20vs%20Qatar%20%3A%20AVC%20Men%27s%20Cup%202026\"},\"content_gating\":null,\"prev_livestreaming\":{\"id\":734,\"title\":\"Trans7\",\"ongoing_schedule\":{\"id\":5304619,\"title\":\"The Police\"}},\"next_livestreaming\":{\"id\":777,\"title\":\"Metro TV\",\"ongoing_schedule\":{\"id\":5303085,\"title\":\"Go Healthy\"}}}"},"redirectURL":"","headersSize":737,"bodySize":2219,"_status":"completed","_startTimestamp":1789143487511502,"_endTimestamp":1789143487550711},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"72.46.87.177","connection":"14","comment":"","_id":215,"_uid":"e4e5c523-a8f3-4e22-b01e-389ddbb622d8","_cid":14,"_ctime":1789143395771,"_sid":29,"_stime":1789143486756,"_serverAddress":"72.46.87.177","_serverAddressFamily":0,"_serverPort":823,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":37086,"_app":{"name":"Vidio","id":"com.vidio.android"}},{"startedDateTime":"2026-09-11T16:18:06.491Z","time":592,"request":{"method":"HEAD","url":"https://www.vidio.com","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":method","value":"HEAD"},{"name":":authority","value":"www.vidio.com"},{"name":":path","value":"/"},{"name":":scheme","value