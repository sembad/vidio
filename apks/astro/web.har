y%2Flogin%3Fflow%3D5d510d55-6c7b-4f40-9114-78e6e78202aa"},{"name":"dt","value":"Astro%20ID"},{"name":"en","value":"login"},{"name":"ep.platform_id","value":"e19c0fcc-8a9a-4985-88ee-3575240d2fdc"},{"name":"ep.profile_id","value":"A1C6A2D5745DC14AB97ACD998A3107"},{"name":"ep.method","value":"Login"},{"name":"ep.event_action","value":"Form%20Submit%20Success"},{"name":"ep.event_label","value":"Verified"},{"name":"ep.event_category","value":"SSO%20Successful%20Login"},{"name":"_et","value":"8990"},{"name":"up.profile_id","value":"A1C6A2D5745DC14AB97ACD998A3107"},{"name":"tfd","value":"31099"}],"headersSize":1554,"bodySize":0,"_status":"completed","_startTimestamp":1791031893796674,"_endTimestamp":1791031893804890},"response":{"status":204,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"204"},{"name":"access-control-allow-origin","value":"https://auth.astro.com.my"},{"name":"date","value":"Sat, 03 Oct 2026 12:51:34 GMT"},{"name":"pragma","value":"no-cache"},{"name":"expires","value":"Fri, 01 Jan 1990 00:00:00 GMT"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"access-control-allow-credentials","value":"true"},{"name":"content-type","value":"text/plain"},{"name":"cross-origin-resource-policy","value":"cross-origin"},{"name":"content-security-policy-report-only","value":"script-src 'none'; form-action 'none'; frame-src 'none'; report-uri https://csp.withgoogle.com/csp/scaffolding/ascnsrsggc:139:0"},{"name":"cross-origin-opener-policy-report-only","value":"same-origin; report-to=ascnsrsggc:139:0"},{"name":"report-to","value":"{\"group\":\"ascnsrsggc:139:0\",\"max_age\":2592000,\"endpoints\":[{\"url\":\"https://csp.withgoogle.com/csp/report-to/scaffolding/ascnsrsggc:139:0\"}],}"},{"name":"server","value":"Golfe2"},{"name":"content-length","value":"0"},{"name":"alt-svc","value":"h3=\":443\"; ma=2592000,h3-29=\":443\"; ma=2592000"}],"content":{"size":0,"mimeType":"text/plain","text":""},"redirectURL"