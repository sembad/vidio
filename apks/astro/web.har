154\", \"Not A(Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"accept","value":"*/*"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-dest","value":"script"},{"name":"referer","value":"https://devicelogin.astro.com.my/ASTRO/device-management/index.html"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7"},{"name":"cookie","value":"WZRK_G=e9387e74f89f4d59b2d4f59176375347"},{"name":"cookie","value":"_gid=GA1.3.49513412.1791031853"},{"name":"cookie","value":"_gat_UA-20278225-8=1"},{"name":"cookie","value":"_gcl_au=1.1.610456866.1791031854"},{"name":"cookie","value":"_ga=GA1.1.2087716981.1791031853"},{"name":"cookie","value":"WZRK_S_W69-8R5-575Z=%7B%22p%22%3A1%2C%22s%22%3A1791031845%2C%22t%22%3A1791031855%7D"},{"name":"cookie","value":"_ga_HPFSEWEKCV=GS2.1.s1791031853$o1$g1$t1791031866$j47$l0$h0"},{"name":"cookie","value":"_ga_S4QHZ9XXCL=GS2.1.s1791031874$o1$g0$t1791031890$j44$l0$h0"},{"name":"cookie","value":"_ga_4Q9DLDY2BM=GS2.1.s1791031875$o1$g0$t1791031890$j45$l0$h1376000022"},{"name":"priority","value":"u=1"}],"queryString":[],"headersSize":1184,"bodySize":0,"_status":"completed","_startTimestamp":1791031893767304,"_endTimestamp":1791031893768751},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"200"},{"name":"content-type","value":"text/javascript"},{"name":"content-length","value":"3533"},{"name":"accept-ranges","value":"bytes"},{"name":"server","value":"AmazonS3"},{"name":"last-modified","value":"Wed, 09 Jul 2025 16:09:49 GMT"},{"name":"x-amz-server-side-encryption","value":"AES256"},{"name":"date","value":"Sat, 03 Oct 2026 04:49:18 GMT"},{"name":"etag","value":"\"405f4042aa4b22127241ef1e202eb904\""},{"name":"x-cache","value":"Hit from cloudfront"},{"name":"via","value":"1.1 519f4b1ac97b08b10023540bb9e7e006.cloudfront.net (CloudFront)"},{"name":"x-amz-cf-pop","value":"SIN2-P2"},{"name":"x-amz-cf-id","value":"-OrSCuROa02SLLd3tf5QcDAyQJOgJ5-xzE4QLvpyJUXX8iueEiNUDw=="},{"name":"age","value":"28937"}],"content":{"size":3533,"mimeType":"text/javascript","text":"/**********************************/\n/** GENERAL AND SUCCESS STRINGS **/\n/**********************************/\n\n// msg shown with a spinner when the device list is updated\nlet UPDATING_DEVICES_MSG = `Updating Device List`;\n\n// msg shown with a spinner when the device list is updated\nlet DELETING_DEVICE_MSG = `Delete Device In Progress`;\n\n// msg shown instead of remove button if the device is unremovable\nlet DEVICE_NOT_REMOVABLE = \"this device cannot be deleted\";\n\n// msg shown next to removable device with its creation date (no time)\nlet DEVICE_CREATED_AT = (deviceCreationDate) => isValidDate(deviceCreationDate) ? `created at ${new Date(deviceCreationDate).toLocaleDateString()}` : ``;\n\n// msg shown instead of remove button if the device can be removed in the future\nlet DEVICE_DELETION_BLOCKED = (deletionBlockedUntilDate) => isValidDate(deletionBlockedUntilDate)? `this device can be deleted after ${new Date(deletionBlockedUntilDate).toLocaleDateString()}` : `device deletion blocked`;\n\n// msg shown in the bottom pane when devices successfully deleted\nlet DELETE_CONFIRMATION_MSG = (deviceName) => `<h5>Successfully removed device</h5>successfully removed device ${deviceName}`;\n\n//msg shown in the bottom pane after the last device needed to be deleted is deleted \nlet REDIRECT_TO_OAUTH_MSG = \"Redirecting...\"; \n\n// msg shown in the modal asking the user to confirm a specific device deletion\nlet DELETE_APPROVAL_MSG = (deviceName) => `Are you sure you want to remove <i><b>${deviceName}</b></i> from your list of authorized devices?<br>`;\n\n// the cancel button updated text with done when the completed the deletion of the required number of devices\nlet DELETION_DONE_BTN_STR = \"Done\";\n\n\n// instruction update according to the min number of of devices left to be deleted\nlet NUM_TO_DELETE_MSG = (minNumToBeDeleted) => {\n  return (minNumToBeDeleted > 0 ?\n    `You have exceeded the maximum allocated devices.<br>\n  Please remove  ${minNumToBeDeleted === 1 ? 'a device' : `${minNumToBeDeleted} devices`} to continue registering this device.`\n    :\n    `You have deleted the required number of devices.<br>\n  Click done to continue registering this device.`\n  )\n}\n\n\n\n/********************************/\n/******** ERROR STRINGS ********/\n/********************************/\n\n// msg on the upper-left corner of the page when one/more of the params in the url\nlet MISSING_PARAMS = `<h1>400 Bad Request</h1>`\n\n// instruction update where there are no removable devices\nlet NO_DEVICE_TO_DELETE = `You have exceeded the maximum allocated devices.<br>\nUnfortunately there are no devices, currently, for you to delete.`\n\n// instruction update where there is less removable devices than the minimum number of devices required to delete\nlet NOT_ENOUGH_REMOVABLE_DEVICES = (removableDevicesCount) => `You need to remove at least ${minDevicesToBeDeleted} devices but have only ${removableDevicesCount} removable devices currently.<br>\nYou can delete those devices if you choose to. Once completed, please cancel this operation.`\n\n// error msg returned for specific error status and timeout\nlet HTTP_CALL_STATUS_MSG = (status) => {\n  switch (status) {\n    case 401:\n      return `Your session has expired. Please cancel the operation.`\n    case \"timeout\":\n      return `Your request has timed out. Please try again.`\n    default:\n      return `An error has occurred. Please try again`\n  }\n}\n\n// the words that represent try again in the msg for error status. this words will be wrapped with a link button\nlet TRY_AGAIN_WORDS = \"try again\""},"redirectURL":"","headersSize":477,"bodySize":3533,"_status":"completed","_startTimestamp":1791031894547052,"_endTimestamp":1791031894551835},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"72.46.87.235","connection":"109","comment":"","_id":414,"_uid":"c485a4cb-fe45-4ff8-93fe-42f5d2a5440e","_cid":109,"_ctime":1791031893061,"_sid":19,"_stime":1791031893767,"_serverAddress":"72.46.87.235","_serverAddressFamily":0,"_serverPort":823,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":39410,"_app":{"name":"Chrome","id":"com.android.chrome"}},{"startedDateTime":"2026-10-03T12:51:33.765Z","time":771,"request":{"method":"GET","url":"https://devicelogin.astro.com.my/ASTRO/device-management/1.0.0-52/javascripts/oauth-ui-config.js","httpVersion":"HTTP/2.0","cookies":[{"name":"WZRK_G","value":"e9387e74f89f4d59b2d4f59176375347"},{"name":"_gid","value":"GA1.3.49513412.1791031853"},{"name":"_gat_UA-20278225-8","value":"1"},{"name":"_gcl_au","value":"1.1.610456866.1791031854"},{"name":"_ga","value":"GA1.1.2087716981.1791031853"},{"name":"WZRK_S_W69-8R5-575Z","value":"%7B%22p%22%3A1%2C%22s%22%3A1791031845%2C%22t%22%3A1791031855%7D"},{"name":"_ga_HPFSEWEKCV","value":"GS2.1.s1791031853$o1$g1$t1791031866$j47$l0$h0"},{"name":"_ga_S4QHZ9XXCL","value":"GS2.1.s1791031874$o1$g0$t1791031890$j44$l0$h0"},{"name":"_ga_4Q9DLDY2BM","value":"GS2.1.s1791031875$o1$g0$t1791031890$j45$l0$h1376000022"}],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"devicelogin.astro.com.my"},{"name":":path","value":"/ASTRO/device-management/1.0.0-52/javascripts/oauth-ui-config.js"},{"name":":scheme","value":"https"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"154\", \"Google Chrome\";v=\"154\", \"Not A(Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"accept","value":"*/*"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-dest","value"