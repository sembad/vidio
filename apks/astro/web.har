":"age","value":"28937"}],"content":{"size":2845,"mimeType":"text/css","text":"html {\n  width: 100%;\n  min-height: 100%;\n  background-repeat: no-repeat;\n  -webkit-background-size: cover;\n  -moz-background-size: cover;\n  -o-background-size: cover;\n  background-size: cover;\n  background-color: black;\n}\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen,\n    Ubuntu, Cantarell, \"Open Sans\", \"Helvetica Neue\", sans-serif;\n  background-color: transparent;\n  color: white;\n}\n\n.modal-content {\n  background-color: rgb(45, 51, 59);\n}\n\n.modal-header,\n.modal-body,\n.modal-footer {\n  border: none;\n}\n\n.modal button[data-dismiss=\"modal\"] {\n  background-color: rgb(73, 87, 101);\n  color: white;\n  border: none;\n}\n\n.modal button.confirm,\n.try-again button {\n  background-color: rgb(107, 131, 154);\n  color: white;\n  border: none;\n}\n\n#heading {\n  font-size: 18px;\n}\n\n#instruction {\n  font-size: 14px;\n  opacity: 70%;\n}\n\n#main-container {\n  height: 353px;\n  overflow-y: scroll;\n}\n\n@media only screen and (max-height: 650px) {\n  #main-container {\n    height: 265px;\n  }\n}\n\n/*********************************/\n/** DEVICE CONTAINER SCROLL BAR **/\n/*********************************/\n\n#main-container {\n  scroll-behavior: smooth;\n  scrollbar-color: rgba(255, 255, 255, 0.8);\n  scrollbar-track-color: transparent;\n}\n\n#main-container::-webkit-scrollbar-track {\n  /* -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);\n  box-shadow: inset 0 0 6px rgba(0,0,0,0.3); */\n  border-radius: 10px;\n  background-color: transparent;\n}\n\n#main-container::-webkit-scrollbar {\n  width: 5px;\n  background-color: transparent;\n}\n\n#main-container::-webkit-scrollbar-thumb {\n  border-radius: 10px;\n  -webkit-box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);\n  box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);\n  background-color: rgba(255, 255, 255, 0.8);\n}\n\n.device-row {\n  border-top: 0.5px solid rgba(255, 255, 255, 0.4);\n}\n\n.device-row:last-child {\n  border-bottom: 0.5px solid rgba(255, 255, 255, 0.4);\n}\n\n.device-type {\n  font-size: 14px;\n  opacity: 70%;\n  font-weight: lighter;\n}\n\n.device-name {\n  font-size: 17px;\n}\n\n.general-btn {\n  color: white;\n  background-color: rgba(255, 255, 255, 0.1);\n}\n\n.action-complete-indication {\n  color: white;\n  background-color: rgb(107, 131, 154);\n  display: none;\n}\n\n.gray-out {\n  position: relative;\n  font-style: italic;\n}\n.gray-out::after {\n  content: '';\n  position: absolute;\n  /* top = (100 - height) / 2 */\n  top: 5%;\n  height: 90%;\n  /* left = (100 - width) / 2 */\n  left: 1%; \n  width: 98%;\n  background-color: gray;\n  opacity: 0.6;\n  border-radius: 0.25rem;\n}\n\n.py-2half {\n  padding-top: 0.75rem !important;\n  padding-bottom: 0.75rem !important;\n}\n\n.btn.btn-link {\n  padding: 0;\n  margin: 0;\n}\n/* \n.alert.alert-danger {\n  background-color: #F32013;\n  color: white;\n} */\n\n/* @media only screen and (min-width: 320px) and (max-width: 580px) {\n  .content-div {\n    width: 40vmax;\n  }\n} */\n"},"redirectURL":"","headersSize":470,"bodySize":2845,"_status":"completed","_startTimestamp":1791031894222858,"_endTimestamp":1791031894229854},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"72.46.87.235","connection":"109","comment":"","_id":409,"_uid":"dbd4330a-a599-4eca-9301-5d192d2a9d7e","_cid":109,"_ctime":1791031893061,"_sid":9,"_stime":1791031893758,"_serverAddress":"72.46.87.235","_serverAddressFamily":0,"_serverPort":823,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":39410,"_app":{"name":"Chrome","id":"com.android.chrome"}},{"startedDateTime":"2026-10-03T12:51:33.757Z","time":466,"request":{"method":"GET","url":"https://devicelogin.astro.com.my/common/device-management/1.0.0-52/stylesheets/spinner.css","httpVersion":"HTTP/2.0","cookies":[{"name":"WZRK_G","value":"e9387e74f89f4d59b2d4f59176375347"},{"name":"_gid","value":"GA1.3.49513412.17910