Light.ttf\") format(\"truetype\");\n}\n\n@font-face {\n  font-family: \"Medium\";\n  src: url(\"../fonts/Roboto-Medium.ttf\") format(\"truetype\");\n}\n\nhtml {\n  background-image: url(\"../images/deviceloginbgcolor.png\");\n}\n\n* {\n  font-family: Regular;\n}\n\n#heading {\n  font-family: Regular;\n  font-size: 18px;\n}\n\n.device-type {\n  opacity: 0.7;\n  font-family: Light;\n  font-size: 14px;\n  font-weight: 300;\n  margin-top: 5px;\n  line-height: normal;\n}\n\n#deleteDeviceModal:focus {\n  outline: none;\n}\n\n#deleteDeviceModal {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  min-height: 180px;\n  min-width: 300px;\n  max-width: 550px;\n}\n\n#deleteDeviceModal .modal-dialog {\n  box-shadow: 0 24px 24px 0 rgba(0, 0, 0, 0.3), 0 0 24px 0 rgba(0, 0, 0, 0.22);\n}\n\n#deleteDeviceModal .modal-content {\n  padding: 24px;\n  background: #424242;\n}\n#deleteDeviceModal .modal-content > div {\n  padding: 0;\n}\n\n#deleteDeviceModal .modal-header .modal-title {\n  font-family: Medium;\n  line-height: 1.4;\n  color: #ebebeb;\n  font-weight: 500;\n}\n\n#deleteDeviceModal .modal-body {\n  opacity: 0.8;\n  font-family: Regular;\n  color: #ebebeb;\n  line-height: 1.5;\n  margin: 10px 0 16px 0;\n}\n\n#deleteDeviceModal button {\n  font-family: Light;\n  width: 110px;\n  height: 44px;\n  color: #fff;\n  border-radius: 4px;\n  background-color: rgba(255, 255, 255, 0.1);\n  border: none;\n}\n\n.action-complete-indication {\n  color: white;\n  background-color: #424242;\n  display: none;\n}\n.pl-15 {\n  padding-left: 15px;\n  padding-right: 0px;\n}\n.pr-15 {\n  padding-right: 15px;\n  padding-left: 0px;\n}\n.p-15 {\n  padding-right: 15px;\n  padding-left: 15px;\n}\n\n@media (max-width: 576px) {\n  .device-row {\n    font-size: 12px;\n  }\n  .device-type {\n    font-size: 12px;\n  }\n  .device-name {\n    font-size: 14px;\n  }\n  .device-remove-btn {\n    font-size: 14px;\n  }\n}\n"},"redirectURL":"","headersSize":470,"bodySize":1987,"_st