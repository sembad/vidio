fSzD66J2j3xqcjFMg0t5HHTyStzU_nepdltj_Oxcg=="},{"name":"age","value":"28937"}],"content":{"size":337,"mimeType":"text/javascript","text":"// OVERRIDES THE DEFAULT ENGLISh STRINGS IN COMMON\n\n// msg shown in the modal asking the user to confirm a specific device deletion\nDELETE_APPROVAL_MSG = (deviceName) => `Are you sure you want to remove <b>${deviceName}</b> from your account?<br>Please note that all downloaded video(s) on that device will be deleted once removed.<br>`;"},"redirectURL":"","headersSize":476,"bodySize":337,"_status":"completed","_startTimestamp":1791031894745063,"_endTimestamp":1791031894755173},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"72.46.87.235","connection":"109","comment":"","_id":418,"_uid":"3c3af405-e0b9-4350-a86d-bbd477c0d49c","_cid":109,"_ctime":1791031893061,"_sid":27,"_stime":1791031893773,"_serverAddress":"72.46.87.235","_serverAddressFamily":0,"_serverPort":823,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":39410,"_app":{"name":"Chrome","id":"com.android.chrome"}},{"startedDateTime":"2026-10-03T12:51:33.772Z","time":999,"request":{"method":"GET","url":"https://devicelogin.astro.com.my/common/device-management/1.0.0-52/javascripts/handler.js","httpVersion":"HTTP/2.0","cookies":[{"name":"WZRK_G","value":"e9387e74f89f4d59b2d4f59176375347"},{"name":"_gid","value":"GA1.3.49513412.1791031853"},{"name":"_gat_UA-20278225-8","value":"1"},{"name":"_gcl_au","value":"1.1.610456866.1791031854"},{"name":"_ga","value":"GA1.1.2087716981.1791031853"},{"name":"WZRK_S_W69-8R5-575Z","value":"%7B%22p%22%3A1%2C%22s%22%3A1791031845%2C%22t%22%3A1791031855%7D"},{"name":"_ga_HPFSEWEKCV","value":"GS2.1.s1791031853$o1$g1$t1791031866$j47$l0$h0"},{"name":"_ga_S4QHZ9XXCL","value":"GS2.1.s1791031874$o1$g0$t1791031890$j44$l0$h0"},{"name":"_ga_4Q9DLDY2BM","value":"GS2.1.s1791031875$o1$g0$t1791031890$j45$l0$h1376000022"}],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"devicelogin.astro.com.my"},{"name":":path","value":"/common/device-management/1.0.0-52/javascripts/handler.js"},{"name":":scheme","value":"https"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"154\", \"Google Chrome\";v=\"154\", \"Not A(Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"accept","value":"*/*"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-dest","value":"script"},{"name":"referer","value":"https://devicelogin.astro.com.my/ASTRO/device-management/index.html"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7"},{"name":"cookie","value":"WZRK_G=e9387e74f89f4d59b2d4f59176375347"},{"name":"cookie","value":"_gid=GA1.3.49513412.1791031853"},{"name":"cookie","value":"_gat_UA-20278225-8=1"},{"name":"cookie","value":"_gcl_au=1.1.610456866.1791031854"},{"name":"cookie","value":"_ga=GA1.1.2087716981.1791031853"},{"name":"cookie","value":"WZRK_S_W69-8R5-575Z=%7B%22p%22%3A1%2C%22s%22%3A1791031845%2C%22t%22%3A1791031855%7D"},{"name":"cookie","value":"_ga_HPFSEWEKCV=GS2.1.s1791031853$o1$g1$t1791031866$j47$l0$h0"},{"name":"cookie","value":"_ga_S4QHZ9XXCL=GS2.1.s1791031874$o1$g0$t1791031890$j44$l0$h0"},{"name":"cookie","value":"_ga_4Q9DLDY2BM=GS2.1.s1791031875$o1$g0$t1791031890$j45$l0$h1376000022"},{"name":"priority","value":"u=1"}],"queryString":[],"headersSize":1172,"bodySize":0,"_status":"completed","_startTimestamp":1791031893772519,"_endTimestamp":1791031893773476},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"200"},{"name":"content-type","value":"text/javascript"},{"name":"content-length","value":"9336"},{"name":"accept-ranges","value":"bytes"},{"name":"server","value":"AmazonS3"},{"name":"last-modified","value":"Wed, 09 Jul 2025 16:09:49 GMT"},{"name":"x-amz-server-side-encryption","value":"AES256"},{"name":"date","value":"Sat, 03 Oct 2026 04:49:18 GMT"},{"name":"etag","value":"\"a0db79656234852284446fd00ec400df\""},{"name":"x-cache","value":"Hit from cloudfront"},{"name":"via","value":"1.1 519f4b1ac97b08b10023540bb9e7e006.cloudfront.net (CloudFront)"},{"name":"x-amz-cf-pop","value":"SIN2-P2"},{"name":"x-amz-cf-id","value":"ciH9gOrGM1CysrUxYf0BIVvQ8w4NRS_RQxiisa5Jv1bG5IqoYJFwSg=="},{"name":"age","value":"28937"}],"content":{"size":9336,"mimeType":"text/javascript","text":"/* CONFIGURATION OF URLS */\n// \"https://sg-sg-sg.aws-vpc-becarmel.ivp.synamedialabs.com:9443\";\nconst SG_HOST_AND_PORT = sgEndpoint;\nconst GET_QUOTA_INFO_URL = (deviceFullType) => `${SG_HOST_AND_PORT}/device-management/deviceQuotaInfo?deviceFullType=${deviceFullType}`;\nconst DELETE_DEVICE_URL = (deviceId) => `${SG_HOST_AND_PORT}/device-management/device/${deviceId}`;\nconst ON_COMPLETION_URL = (state) => `${SG_HOST_AND_PORT}/oauth2/deviceManagementEnd?state=${state}`;\n\nlet devices;\nlet minDevicesToBeDeleted;\nlet accessToken;\nlet deviceFullType;\nlet state;\n\n/* SELECTORS */\nconst MAIN_CONTAINER = \"#main-container\"; // contain the devices container, the spinner and the alert\nconst GET_DEVICE_LIST_ERR = \"#device-list-error\";\nconst DEVICES_CONTAINER = \"#devices-container\";\nconst SPINNER = \"#spinner-container\";\nconst DELETE_MODAL = \"#deleteDeviceModal\";\nconst BOTTOM_PANE = \".action-complete-indication\";\nconst INSTRUCTION = \"#instruction .text\";\nconst CANCEL_DONE_BTN = \"#deletion-completed\";\n\n\n/* DEVICE DELETION MSG */\nfunction showAlert(text, durationSeconds) {\n  const alertElem = $(BOTTOM_PANE);\n  alertElem.html(text);\n  alertElem.slideDown(); // shows the alert\n  setTimeout(() => {\n    alertElem.slideUp(); // hides the alert\n  }, durationSeconds * 1000);\n}\n\nfunction successAlert(msg) {\n  showAlert(msg, DELETE_SUCCESS_MSG_DURATION);\n}\n\nfunction errorAlert(msg) {\n  showAlert(msg, DELETE_ERROR_MSG_DURATION);\n}\n\nfunction setDomBeforeHttpCall(msg, disableBtn) {\n  const spinnerTextDiv = $(MAIN_CONTAINER).find('.spinner-text')[0];\n  $(spinnerTextDiv).html(msg)\n  hideElement(DEVICES_CONTAINER)\n  const isSpinnerHidden = $(MAIN_CONTAINER).find(SPINNER).attr('hidden') !== undefined;\n  if (isSpinnerHidden) {\n    showElement(SPINNER)\n  }\n  if (disableBtn) {\n    $(CANCEL_DONE_BTN).attr('disabled', true);\n  }\n}\n\nfunction clearDomAfterHttpCall() {\n  $(CANCEL_DONE_BTN).removeAttr('disabled');\n  hideElement(SPINNER);\n}\n\nfunction missingParams() {\n  console.log(\"the following params are missing:\",\n    state == undefined ? \"state\" : \"\",\n    deviceFullType == undefined ? \"device_full_type\" : \"\",\n    accessToken == undefined ? \"access_token\" : \"\")\n  $(\"body\").empty();\n  $(\"body\").html(MISSING_PARAMS)\n}\n\n// small private function for try again btn when error getting the device list\nfunction retry() {\n  hideElement(GET_DEVICE_LIST_ERR);\n  getAndRenderDevices();\n}\n\nfunction handleErrorDeviceList(error, status) {\n  let deviceListErrElem = $(GET_DEVICE_LIST_ERR);\n  if (status !== 401) // 401 is the only case when we don't allow the try again option\n  {\n    // wrap the try again words in link button\n    const startIndex = error.toLowerCase().indexOf(TRY_AGAIN_WORDS);\n    if (startIndex === -1) {\n      console.log(`ERROR: unable to find the ${TRY_AGAIN_WORDS} words in error string. the words are required to wrap in function to retry getting the device list`);\n      return;\n    }\n    error = insert(error, startIndex, \"<button class='btn btn-link' onclick='retry()'>\")\n    error = insert(error, error.indexOf(TRY_AGAIN_WORDS) + TRY_AGAIN_WORDS.length, \"</button>\");\n  }\n  deviceListErrElem.find('.error-text').html(error);\n  showElement(GET_DEVICE_LIST_ERR);\n}\n\n/* MAIN FUNCTIONS */\nfunction updateDoneBtnState() {\n  if (minDevicesToBeDeleted <= 0) {\n    $(CANCEL_DONE_BTN).text(DELETION_DONE_BTN_STR);\n  }\n}\n\nfunction updateInstruction(_text) {\n  if (!_text) {\n    $(INSTRUCTION).html(\n      NUM_TO_DELETE_MSG(minDevicesToBeDeleted)\n    );\n  } else {\n    $(INSTRUCTION).html(_text)\n  }\n\n}\n\nfunction deleteDevice(deviceId, deviceName) {\n  // indicate the deletion process is happening and prevent the user from starting another one\n  setDomBeforeHttpCall(DELETING_DEVICE_MSG, true);\n\n  let client = new HttpClient();\n  client(DELETE_DEVICE_URL(deviceId), \"DELETE\", function (_, status, error) {\n    if (status === 200 || status === 404) {\n      successAlert(DELETE_CONFIRMATION_MSG(deviceName));\n    } else {\n      if (status === 401) {\n        clearDomAfterHttpCall();\n        handleErrorDeviceList(error, status);\n        return;\n      } else {\n        errorAlert(error);\n      }\n    }\n\n    if (status === 200 || status === 404)\n    // the only times the list gets updated is if OK and device to delete was not found\n    {\n      getAndRenderDevices();\n    } else {\n      clearDomAfterHttpCall();\n      showElement(DEVICES_CONTAINER);\n    }\n  })\n\n}\n\nfunction setUpDeleteDeviceModal() {\n  $(DELETE_MODAL).on('show.bs.modal', function (event) {\n    let button = $(event.relatedTarget) // button that triggered the modal\n\n    const deviceId = button.data('deviceId') // extract info from data-* attributes\n    const deviceData = devices.find(device => device.deviceId === deviceId)\n    const deviceName = deviceData.friendlyName || deviceData.displayDeviceType; // if the friendlyName doesn't exist the displayDeviceType will be used\n\n    let modal = $(this)\n\n    const confirmBtn = modal.find('button.confirm');\n    confirmBtn.trigger('focus');\n\n    modal.find('.modal-body').html(DELETE_APPROVAL_MSG(deviceName));\n    confirmBtn.off('click'); // detach the previous click event to add the new one (with different device)\n    confirmBtn.click(function (e) {\n      e.preventDefault();\n      modal.modal('hide');\n      deleteDevice(deviceData.deviceId, deviceName);\n    });\n  })\n\n}\n\nfunction handleDeletionComplete() {\n  updateDoneBtnState();\n  updateInstruction();\n  setDomBeforeHttpCall(REDIRECT_TO_OAUTH_MSG, false);\n  setTimeout(redirectToOAuth, REDIRECT_TO_OAUTH_MSG_DURATION * 1000);\n}\n\nlet renderRemovableDeviceRow = (index, device) => {\n  return `\n    <div key=${index} class=\"row align-items-center justify-content-between py-2half device-row flex-nowrap\">\n      <div class=\"col pl-15\">\n          <div class=\"row device-name\">\n              <div class=\"col\">\n                  ${device.displayDeviceType}\n              </div>\n          </div>\n          <div class=\"row device-type\">\n              <div class=\"col\">\n                  ${device.friendlyName || \"\"}\n              </div>\n          </div>\n      </div>\n      <div class=\"col text-center p-15 font-weight-light\">\n        ${device.createdAt ? DEVICE_CREATED_AT(device.createdAt) : \"\"}\n      </div>\n      <div class=\"col text-right pr-15\">\n          <button \n            type=\"button\" \n            class=\"btn general-btn py-2half device-remove-btn\" \n            data-toggle=\"modal\" \n            data-target=\"#deleteDeviceModal\"\n            data-device-id=${device.deviceId}>\n              Remove\n          </button>\n      </div>\n    </div>\n  `\n}\n\nlet renderUnRemovableDeviceRow = (index, device) => {\n  return `\n  <div key=${index} class=\"row align-items-center justify-content-between py-2half device-row gray-out\">\n    <div class=\"col-sm col\">\n        <div class=\"row device-name\">\n            <div class=\"col\">\n                ${device.displayDeviceType}\n            </div>\n        </div>\n        <div class=\"row device-type\">\n            <div class=\"col\">\n                ${device.friendlyName || \"\"}\n            </div>\n        </div>\n    </div>\n    <div class=\"col-sm-auto col\">\n      ${device.deletionBlockedUntil ? DEVICE_DELETION_BLOCKED(device.deletionBlockedUntil) : DEVICE_NOT_REMOVABLE}\n    </div>\n  </div>\n`\n}\n\nfunction getAndRenderDevices() {\n  setDomBeforeHttpCall(UPDATING_DEVICES_MSG, true);\n  let client = new HttpClient();\n  client(GET_QUOTA_INFO_URL(deviceFullType), \"GET\", function (response, status, error) {\n    clearDomAfterHttpCall();\n    if (error) {\n      handleErrorDeviceList(error, status);\n    }\n    else {\n      devices = response.devices;\n      minDevicesToBeDeleted = response.minNumToBeDeleted;\n\n      $(DEVICES_CONTAINER).empty();\n\n      if (minDevicesToBeDeleted <= 0) {\n        handleDeletionComplete();\n        return;\n      }\n\n      let devicesContainer = $(DEVICES_CONTAINER);\n      const sortedDevices = sortDevices(devices);\n\n      let removableDevicesCount = 0;\n      sortedDevices.map((device, index) => {\n        if (device.isQuotaOccupier && !device.deletionBlockedUntil) {\n          removableDevicesCount++;\n          devicesContainer.append(renderRemovableDeviceRow(index, device));\n        } else {\n          devicesContainer.append(renderUnRemovableDeviceRow(index, device));\n        }\n      });\n      showElement(devicesContainer);\n\n      if (removableDevicesCount === 0 && minDevicesToBeDeleted > 0)\n      // there are no devices to delete but at least one to be deleted\n      {\n        updateInstruction(NO_DEVICE_TO_DELETE)\n      } else {\n        if (minDevicesToBeDeleted > removableDevicesCount)\n        // there are not enough devices to satisfy the min devices to be deleted\n        {\n          updateInstruction(NOT_ENOUGH_REMOVABLE_DEVICES(removableDevicesCount));\n        } else {\n          // there are enough removable devices to satisfy the min devices to be deleted \n          updateInstruction();\n        }\n      }\n    }\n  });\n}\n\n$(document).ready(function () {\n  let params = fragmentHashToJson();\n  state = params[\"state\"];\n  accessToken = params[\"access_token\"];\n  deviceFullType = params[\"device_full_type\"];\n\n  if (!state || !accessToken || !deviceFullType) // those elements are required for the page\n  {\n    missingParams();\n  }\n\n  getAndRenderDevices();\n  setUpDeleteDeviceModal();\n\n  $(CANCEL_DONE_BTN).click(function (e) {\n    e.preventDefault();\n    redirectToOAuth();\n  });\n});"},"redirectURL":"","headersSize":477,"bodySize":9336,"_status":"completed","_startTimestamp":1791031894767016,"_endTimestamp":1791031894771710},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"72.46.87.235","connection":"109","comment":"","_id":417,"_uid":"1c1c3847-2485-42d3-8281-c59609066cc7","_cid":109,"_ctime":1791031893061,"_sid":25,"_stime":1791031893772,"_serverAddress":"72.46.87.235","_serverAddressFamily":0,"_serverPort":823,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":39410,"_app":{"name":"Chrome","id":"com.android.chrome"}},{"startedDateTime":"2026-10-03T12:51:33.770Z","time":813,"request":{"method":"GET","url":"https://devicelogin.astro.com.my/common/device-management/1.0.0-52/javascripts/general_functions.js","httpVersion":"HTTP/2.0","cookies":[{"name":"WZRK_G","value":"e9387e74f89f4d59b2d4f59176375347"},{"name":"_gid","value":"GA1.3.49513412.1791031853"},{"name":"_gat_UA-20278225-8","value":"1"},{"name":"_gcl_au","value":"1.1.610456866.1791031854"},{"name":"_ga","value":"GA1.1.2087716981.1791031853"},{"name":"WZRK_S_W69-8R5-575Z","value":"%7B%22p%22%3A1%2C%22s%22%3A1791031845%2C%22t%22%3A1791031855%7D"},{"name":"_ga_HPFSEWEKCV","value":"GS2.1.s1791031853$o1$g1$t1791031866$j47$l0$h0"},{"name":"_ga_S4QHZ9XXCL","value":"GS2.1.s1791031874$o1$g0$t1791031890$j44$l0$h0"},{"name":"_ga_4Q9DLDY2BM","value":"GS2.1.s1791031875$o1$g0$t1791031890$j45$l0$h1376000022"}],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"devicelogin.astro.com.my"},{"name":":path","value":"/common/device-management/1.0.0-52/javascripts/general_functions.js"},{"name":":scheme","value":"https"},{"name":"sec-ch-ua-platform","value":"\"Linux\""},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"154\", \"Google Chrome\";v=\"154\", \"Not A(Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"accept","value":"*/*"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-dest","value":"script"},{"name":"referer","value":"https://devicelogin.astro.com.my/ASTRO/device-management/index.html"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7"},{"name":"cookie","value":"WZRK_G=e9387e74f89f4d59b2d4f59176375347"},{"name":"cookie","value":"_gid=GA1.3.49513412.1791031853"},{"name":"cookie","value":"_gat_UA-20278225-8=1"},{"name":"cookie","value":"_gcl_au=1.1.610456866.1791031854"},{"name":"cookie","value":"_ga=GA1.1.2087716981.1791031853"},{"name":"cookie","value":"WZRK_S_W69-8R5-575Z=%7B%22p%22%3A1%2C%22s%22%3A1791031845%2C%22t%22%3A1791031855%7D"},{"name":"cookie","value":"_ga_HPFSEWEKCV=GS2.1.s1791031853$o1$g1$t1791031866$j47$l0$h0"},{"name":"cookie","value":"_ga_S4QHZ9XXCL=GS2.1.s1791031874$o1$g0$t1791031890$j44$l0$h0"},{"name":"cookie","value":"_ga_4Q9DLDY2BM=GS2.1.s1791031875$o1$g0$t1791031890$j45$l0$h1376000022"},{"name":"priority","value":"u=1"}],"queryString":[],"headersSize":1182,"bodySize":0,"_status":"completed","_startTimestamp":1791031893770995,"_endTimestamp":1791031893772161},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"200"},{"name":"content-type","value":"text/javascript"},{"name":"content-length","value":"4782"},{"name":"accept-ranges","value":"bytes"},{"name":"server","value":"AmazonS3"},{"name":"last-modified","value":"Wed, 09 Jul 2025 16:09:49 GMT"},{"name":"x-amz-server-side-encryption","value":"AES256"},{"name":"date","value":"Sat, 03 Oct 2026 04:49:18 GMT"},{"name":"etag","value":"\"1a8f101f146cad9dc4d819a26cb97793\""},{"name":"x-cache","value":"Hit from cloudfront"},{"name":"via","value":"1.1 519f4b1ac97b08b10023540bb9e7e006.cloudfront.net (CloudFront)"},{"name":"x-amz-cf-pop","value":"SIN2-P2"},{"name":"x-amz-cf-id","value":"oSdMUMOtVx6so0TbW2hbBwgDh29K737Wl0e4sSKP6bj1zKNn2YYHEw=="},{"name":"age","value":"28937"}],"content":{"size":4782,"mimeType":"text/javascript","text":"/* VISIBILITY HANDLERS */\nfunction changeElementVisibility(elemSelector, shouldHide) {\n    if (shouldHide) {\n        $(elemSelector).attr(\"hidden\", \"hidden\");\n    } else {\n        $(elemSelector).removeAttr(\"hidden\");\n    }\n}\n\nfunction showElement(elemSelector) {\n    changeElementVisibility(elemSelector, false);\n}\n\nfunction hideElement(elemSelector) {\n    changeElementVisibility(elemSelector, true);\n}\n\n/**\n * check if a string is a valid date\n */\nfunction isValidDate(anyStr) {\n    let d = new Date(anyStr)\n    return Object.prototype.toString.call(d) === \"[object Date]\" && !isNaN(d.getTime())\n}\n\n/**\n * send HTTP requests and returns the result\n */\nfunction HttpClient() {\n    function get(aUrl, method, aCallback) {\n        let responseExpected = method === \"GET\"\n        let anHttpRequest = new XMLHttpRequest();\n        anHttpRequest.ontimeout = function () {\n            console.log(`http call has timed out with status ${anHttpRequest.status} and response ${anHttpRequest.response}`)\n            aCallback(undefined, \"timeout\", HTTP_CALL_STATUS_MSG(\"timeout\"));\n        }\n        anHttpRequest.onerror = function () {\n            console.log(`an error occurred when trying to make http call: status=${anHttpRequest.status} response=${anHttpRequest.response}`)\n            aCallback(undefined, \"error\", HTTP_CALL_STATUS_MSG(anHttpRequest.status));\n        }\n        anHttpRequest.onload = function () {\n            if (anHttpRequest.readyState === 4) {\n                const status = anHttpRequest.status;\n                if (status === 200) {\n                    aCallback(responseExpected ? JSON.parse(anHttpRequest.responseText) : undefined, status);\n                }\n                else {\n                    console.log(`http call completed with status ${anHttpRequest.status} and response ${anHttpRequest.response}`)\n                    aCallback(undefined, status, HTTP_CALL_STATUS_MSG(status))\n                }\n            }\n        }\n        anHttpRequest.withCredentials = true;\n        anHttpRequest.open(method, aUrl, true);\n        anHttpRequest.timeout = HTTP_CALL_TIMEOUT * 1000;\n        anHttpRequest.setRequestHeader(\"Authorization\", \"Bearer \" + accessToken);\n        anHttpRequest.send();\n    };\n    return get;\n}\n\n/**\n * fragment the hash part of the URL to key-value pair in JSON form\n */\nfunction fragmentHashToJson() {\n    let pairs = window.location.hash.slice(1).split('&');\n    let result = {};\n    pairs.forEach(function (pair) {\n        pair = pair.split('=');\n        result[pair[0]] = decodeURIComponent(pair[1] || '');\n    });\n\n    return JSON.parse(JSON.stringify(result));\n}\n/**\n * sort list of devices by a date key, if exist. if not - will sort by displayDeviceType\n * @param {array} list - the devices list to sort\n * @param {string} dateKey - the date key name to sort by\n */\nfunction sortByDateKey(list, dateKey) {\n    list.sort((objectA, objectB) => {\n        if (objectA[dateKey] && !objectB[dateKey]) {\n            return -1; // objectA should be before objectB\n        }\n        if (!objectA[dateKey] && objectB[dateKey]) {\n            return 1; // objectB should be before objectA\n        }\n        if (objectA[dateKey] && objectB[dateKey]) {\n            return (new Date(objectA[dateKey]) < new Date(objectB[dateKey]) ? -1 : 1);\n        }\n        // both devices don't have dateKey property so they should be sorted by name\n        return objectA.displayDeviceType.localeCompare(objectB.displayDeviceType)\n    });\n}\n\n/**\n * sort device list into two divided lists - removable and non-removable\n * each list is sorted by the display name and then merged so the non-removable devices are last\n * @param {array} devices - the device list to sort\n */\nfunction sortDevices(devices) {\n    let removableDevices = [];\n    let unRemovableDevices = [];\n    devices.forEach((device) => {\n        if (device.isQuotaOccupier && !device.deletionBlockedUntil) {\n            removableDevices.push(device);\n        } else {\n            unRemovableDevices.push(device);\n        }\n    });\n\n    sortByDateKey(removableDevices, \"createdAt\");\n    sortByDateKey(unRemovableDevices, \"deletionBlockedUntil\");\n\n    const sortedDevices = removableDevices.concat(unRemovableDevices);\n\n    return sortedDevices;\n}\n\n/**\n * insert content into a string in a specific location\n * @param {string} string the string to insert the content into\n * @param {number} index the start index in the string to insert the content\n * @param {string} contentToInsert the content to insert to the string\n */\nfunction insert(string, index, contentToInsert) {\n    return string.slice(0, index) + contentToInsert + string.slice(index);\n}\n\n/**\n * redirects the page to oauth completion url\n */\nfunction redirectToOAuth() {\n    window.location.href = ON_COMPLETION_URL(state);\n}"},"redirectURL":"","headersSize":477,"bodySize":4782,"_status":"completed","_startTimestamp":1791031894578488,"_endTimestamp":1791031894583508},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"72.46.87.235","connection":"109","comment":"","_id":416,"_uid":"8a009f87-2a35-41c1-9e27-17956502d369","_cid":109,"_ctime":1791031893061,"_sid":23,"_stime":1791031893770,"_serverAddress":"72.46.87.235","_serverAddressFamily":0,"_serverPort":823,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":39410,"_app":{"name":"Chrome",