<script src=\"../../common/device-management/1.0.0-52/javascripts/general_config.js\"></script>\n    <script src=\"../../common/device-management/1.0.0-52/javascripts/general_functions.js\"></script>\n    <script src=\"../../common/device-management/1.0.0-52/javascripts/handler.js\"></script>\n    <script src=\"./1.0.0-52/javascripts/default_eng_strings.js\"></script>\n    <link rel=\"stylesheet\" href=\"../../common/vendor/1.0.0-52/stylesheets/bootstrap.min.css\" />\n    <link rel=\"stylesheet\" href=\"../../common/device-management/1.0.0-52/stylesheets/spinner.css\" />\n    <link rel=\"stylesheet\" href=\"../../common/device-management/1.0.0-52/stylesheets/style.css\" />\n    <link rel=\"stylesheet\" href=\"./1.0.0-52/stylesheets/style.css\" />\n</head>\n\n<body>\n    <div class=\"container\">\n\n        <div id=\"logo\" class=\"row align-items-center justify-content-center text-center my-5\">\n            <div class=\"col-4 col-md-2\">\n                <img src=\"./1.0.0-52/images/operator_logo.png\" class=\"img-fluid\" alt=\"operator logo\">\n            </div>\n        </div>\n\n        <div id=\"heading\" class=\"row align-items-center justify-content-center\">\n            <div class=\"col text-center\"> Registered Devices </div>\n        </div>\n\n        <div id=\"instruction\" class=\"row align-items-center justify-content-center mt-2\">\n            <div class=\"col text-center text\"> You have exceeded the maximum allocated devices.<br>Please remove devices\n                to continue registering this device.\n            </div>\n        </div>\n\n        <div class=\"row align-items-center justify-content-center mt-5\">\n            <div id=\"main-container\" class=\"col-lg-7 col-md-9 col m-1\">\n                <div id=\"spinner-container\" hidden>\n                    <div id=\"spinner\"></div>\n                    <div class=\"text-center spinner-text\"></div>\n                </div>\n                <div id=\"device-list-error\" class=\"mx-auto alert alert-danger container\" hidden>\n                    <div class=\"row text-center\">\n                        <div class=\"col error-text\"></div>\n                    </div>\n                </div>\n                <div id=\"devices-container\">\n                </div>\n            </div>\n        </div>\n        <div class=\"row mt-3\">\n            <div class=\"col text-center\">\n                <button id=\"deletion-completed\" type=\"button\" class=\"btn general-btn py-2half px-4\" disabled>\n                    Cancel\n                </button>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"action-complete-indication container-fluid w-100 fixed-bottom p-3\">\n    </div>\n\n    <div class=\"modal\" id=\"deleteDeviceModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"deleteDeviceModalLabel\"\n        aria-hidden=\"true\" data-backdrop=\"false\">\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header\">\n                    <h5 class=\"modal-title\" id=\"deleteDeviceModalLabel\">Confirmation</h5>\n                </div>\n                <div class=\"modal-body\">\n                </div>\n                <div class=\"modal-footer\">\n                    <button type=\"button\" class=\"btn btn-secondary\" data-dismiss=\"modal\">Cancel</button>\n                    <button type=\"button\" class=\"btn btn-primary confirm\">Remove</button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n</body>\n\n</html>"},"redirectURL":"","headersSize":471,"bodySize":4159,"_status":"completed","_startTimestamp":1791031893677228,"_endTimestamp":1791031893683835},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"72.46.87.235","connection":"109","comment":"","_id":404,"_uid":"01a07ff4-3f06-4446-bb15-e61d039c7e43","_cid":109,"_ctime":1791031893061,"_sid":1,"_stime":1791031893061,"_serverAddress":"