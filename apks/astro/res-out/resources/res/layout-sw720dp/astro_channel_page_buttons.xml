<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/astroPrimaryButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/secondaryButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/astro_primary_button"/>
    <Button
        android:textColor="@android:color/white"
        android:id="@+id/secondaryButton"
        android:background="@drawable/astro_secondary_button_background"
        android:visibility="visible"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:foreground="@drawable/secondary_buttons_ripple_animation"
        android:textAllCaps="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/showMoreButton"
        app:layout_constraintStart_toEndOf="@+id/astroPrimaryButton"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SecondaryButtonTextStyleInTablets"/>
    <Button
        android:textColor="@android:color/white"
        android:id="@+id/showMoreButton"
        android:background="@drawable/astro_secondary_button_background"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:foreground="@drawable/secondary_buttons_ripple_animation"
        android:textAllCaps="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondaryButton"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SecondaryButtonTextStyleInTablets"/>
</androidx.constraintlayout.widget.ConstraintLayout>
