<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item android:top="0dp">
                <shape>
                    <gradient
                        android:startColor="#40bababa"
                        android:endColor="#30e2e2e2"
                        android:angle="90"/>
                    <corners android:radius="1dp"/>
                    <padding
                        android:left="1dp"
                        android:top="0dp"
                        android:right="1dp"
                        android:bottom="3dp"/>
                </shape>
            </item>
            <item android:top="0dp">
                <shape>
                    <corners android:radius="2dp"/>
                    <solid android:color="#ffffff"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:top="0dp">
                <shape>
                    <gradient
                        android:startColor="#40bababa"
                        android:endColor="#30e2e2e2"
                        android:angle="90"/>
                    <corners android:radius="1dp"/>
                    <padding
                        android:left="1dp"
                        android:top="0dp"
                        android:right="1dp"
                        android:bottom="3dp"/>
                </shape>
            </item>
            <item android:top="0dp">
                <shape>
                    <corners android:radius="2dp"/>
                    <solid android:color="#ffffff"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="0dp">
                <shape>
                    <gradient
                        android:startColor="#40bababa"
                        android:endColor="#30e2e2e2"
                        android:angle="90"/>
                    <corners android:radius="1dp"/>
                    <padding
                        android:left="1dp"
                        android:top="0dp"
                        android:right="1dp"
                        android:bottom="3dp"/>
                </shape>
            </item>
            <item android:top="0dp">
                <shape>
                    <corners android:radius="2dp"/>
                    <solid android:color="#ffffff"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
