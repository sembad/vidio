<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BrandTitleStyle" parent="@style/RobotoMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#ebebeb</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="BrandedPageToolbarSearchIconStyle" parent="@style/BrandedPageToolbarBackIconStyle">
    </style>
    <style name="BrandedSwimLaneTitleStyle" parent="@style/RobotoMedium">
        <item name="android:textSize">@dimen/branded_swimlane_title_text_size</item>
        <item name="android:textColor">#ebebeb</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fadingEdgeLength">40dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:requiresFadingEdge">horizontal</item>
    </style>
    <style name="SwimLaneItemTitleStyle" parent="@style/RobotoMedium">
        <item name="android:textSize">@dimen/hub_screen_swimlane_title_text_size</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fadingEdgeLength">40dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:requiresFadingEdge">horizontal</item>
    </style>
    <style name="Widget.Design.TabLayout" parent="@style/Base.Widget.Design.TabLayout">
        <item name="tabGravity">center</item>
        <item name="tabMode">fixed</item>
    </style>
</resources>
