<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_advanced_hero_banner_2_3_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/tile_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/tile_poster_gradient"
        android:background="@drawable/tile_poster_gradient_no_radius"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignBottom="@+id/tile_poster"/>
    <TextView
        android:textSize="10sp"
        android:id="@+id/hero_banner_labels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:lineSpacingMultiplier="1.17"
        android:layout_marginStart="@dimen/tile_grid_margin"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tile_metadata1_title"
        app:layout_constraintEnd_toEndOf="@+id/verticalGuideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AssetLabelDisplay"/>
    <TextView
        android:textSize="@dimen/tile_hero_banner_text_size"
        android:textColor="@android:color/white"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/tile_metadata1_title"
        android:fadingEdgeLength="40dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:singleLine="true"
        android:shadowColor="@color/hero_banner_shadow_color"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:lineSpacingExtra="6sp"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="@dimen/tile_grid_margin"
        android:layout_marginEnd="@dimen/tile_grid_margin"
        app:layout_constraintBottom_toTopOf="@+id/tile_metadata1_second_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/tile_grid_meta_data_title_color"
        android:ellipsize="none"
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tile_metadata1_second_line"
        android:fadingEdgeLength="40dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:shadowColor="@color/hero_banner_shadow_color"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:requiresFadingEdge="horizontal"
        android:layout_marginStart="@dimen/tile_grid_margin"
        android:layout_marginEnd="@dimen/tile_grid_margin"
        app:layout_constraintBottom_toTopOf="@+id/tile_metadata1_third_line_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="121dp"
        android:overScrollMode="never"
        android:layout_marginStart="@dimen/tile_grid_margin"
        android:layout_marginEnd="@dimen/tile_grid_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/tile_third_line_metadata_color"
            android:ellipsize="none"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tile_metadata1_third_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:shadowColor="@color/hero_banner_shadow_color"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:lineSpacingExtra="3sp"
            android:textAlignment="viewStart"
            android:layout_marginEnd="4dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/tile_third_line_metadata_color"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginEnd="3dp"/>
    </LinearLayout>
    <FrameLayout
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tile_metadata1_third_line_layout">
        <include layout="@layout/hero_banner_button"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/verticalGuideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.45"/>
</androidx.constraintlayout.widget.ConstraintLayout>
