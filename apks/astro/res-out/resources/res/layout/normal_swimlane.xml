<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp">
    <TextView
        android:id="@+id/swimLaneTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hub_screen_swimlane_gap_from_start_or_end"
        android:layout_marginEnd="@dimen/gap_between_title_and_see_all_text"
        app:layout_constraintBottom_toTopOf="@+id/swimLaneItemsList"
        app:layout_constraintEnd_toStartOf="@+id/swimLaneSeeAll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SwimLaneItemTitleStyle"/>
    <TextView
        android:id="@+id/swimLaneSeeAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="13dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/swimLaneTitle"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/SwimLaneItemSeeAllStyle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/swimLaneItemsList"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:paddingStart="@dimen/hub_screen_swimlane_gap_from_start_or_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swimLaneTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
