<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="#b3ebebeb"
        android:ellipsize="none"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tile_metadata1_title"
        android:fadingEdgeLength="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:requiresFadingEdge="horizontal"
        android:textAlignment="viewStart"
        android:layout_marginEnd="8dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#b3ebebeb"
        android:ellipsize="none"
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tile_metadata1_second_line"
        android:fadingEdgeLength="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:requiresFadingEdge="horizontal"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0px"
        android:layout_marginTop="1dp"
        android:overScrollMode="never">
        <TextView
            android:textSize="12sp"
            android:textColor="#b3ebebeb"
            android:ellipsize="none"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tile_metadata1_third_line"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            android:layout_marginEnd="4dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#bfffffff"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginEnd="3dp"/>
    </LinearLayout>
</LinearLayout>
