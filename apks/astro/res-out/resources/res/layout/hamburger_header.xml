<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/hamburger_header_layout"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hamburger_header_height"
    android:layout_centerVertical="true">
    <ImageView
        android:id="@+id/hamburger_customer_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/hamburger_logo"
        android:scaleType="fitXY"
        android:layout_marginStart="16pt"/>
    <LinearLayout
        android:id="@+id/hamburger_header_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12pt"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/hamburger_header_title_back"
            android:padding="0pt"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="&lt;"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
            android:textSize="12pt"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/hamburger_header_title_text"
            android:padding="0pt"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="56dp"/>
    </LinearLayout>
</RelativeLayout>
