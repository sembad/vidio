<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/HeroBannerButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardCornerRadius="8dp">
    <RelativeLayout
        android:background="@drawable/hero_banner_button_bg_gadient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="#ebebeb"
            android:gravity="center_vertical"
            android:id="@+id/hero_banner_button_icon"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ebebeb"
            android:gravity="center_vertical"
            android:id="@+id/hero_banner_button_text"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Watch"
            android:layout_toRightOf="@+id/hero_banner_button_icon"
            android:paddingEnd="16dp"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
