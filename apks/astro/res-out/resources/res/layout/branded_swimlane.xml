<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swimlane_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp">
    <TextView
        android:id="@+id/brandedSwimLaneTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hub_screen_swimlane_gap_from_start_or_end"
        app:layout_constraintBottom_toTopOf="@+id/brandedSwimLaneItemsList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/BrandedSwimLaneTitleStyle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/brandedSwimLaneItemsList"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:paddingStart="@dimen/hub_screen_swimlane_gap_from_start_or_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/brandedSwimLaneTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
