<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seeAllItemParentLayout"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/tile_collection_swimlane_item_height_mobile"
    android:layout_marginStart="@dimen/coll_swim_see_all_icon_start_margin"
    android:layout_marginEnd="@dimen/coll_swim_see_all_icon_end_margin">
    <ImageView
        android:id="@+id/collectionSwimlaneSeeAllIcon"
        android:layout_width="@dimen/coll_swim_see_all_icon_width_mobile"
        android:layout_height="@dimen/coll_swim_see_all_icon_height_mobile"
        android:src="@drawable/ic_collection_swimlane_see_all_icon"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/collectionSwimlaneSeeAllTextMobile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/coll_swim_see_all_text_size_mobile"
        android:textColor="@color/coll_swim_see_all_text_color"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/collectionSwimlaneSeeAllTextMobile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coll_swim_see_all_text_top_margin_mobile"
        android:singleLine="true"
        android:lineSpacingMultiplier="1.67"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/collectionSwimlaneSeeAllIcon"
        app:layout_constraintStart_toStartOf="@+id/collectionSwimlaneSeeAllIcon"
        app:layout_constraintTop_toBottomOf="@+id/collectionSwimlaneSeeAllIcon"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/seeAllButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="collectionSwimlaneSeeAllIcon,collectionSwimlaneSeeAllTextMobile"/>
</androidx.constraintlayout.widget.ConstraintLayout>
