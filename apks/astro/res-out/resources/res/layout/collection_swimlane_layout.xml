<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collection_swimlane_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/collection_swimlane_layout_height_mobile"
    android:layout_marginBottom="@dimen/collection_swimlane_layout_bottom_margin_mobile"
    android:foreground="@drawable/rectangular_ripple_animation">
    <ImageView
        android:id="@+id/collectionSwimlanePoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <TextView
        android:textSize="@dimen/collection_swimlane_title_text_size_mobile"
        android:textColor="@color/collection_swimlane_title_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/collection_swimlane_title"
        android:layout_width="@dimen/collection_swimlane_title_width_mobile"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:shadowColor="@color/collection_swimlane_title_shadow_color"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:lineSpacingMultiplier="1.34"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/collection_swimlane_title_start_margin_mobile"
        app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <HorizontalScrollView
        android:id="@+id/horizontalScrollView"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:paddingStart="@dimen/coll_swim_scroll_view_start_padding"
        android:paddingEnd="@dimen/coll_swim_scroll_view_end_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/collection_swimlane_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/collection_swimlane_content_list_relative_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/collectionSwimlaneSeeAllIcon"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.cisco.veop.client.kiott.utils.HorizontalRecyclerView
                    android:id="@+id/collection_swimlane_content_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/collectionSwimlaneSeeAllIcon"
                android:layout_width="@dimen/coll_swim_see_all_icon_width_mobile"
                android:layout_height="@dimen/coll_swim_see_all_icon_height_mobile"
                android:src="@drawable/ic_collection_swimlane_see_all_icon"
                android:scaleType="fitXY"
                android:layout_marginStart="@dimen/coll_swim_see_all_icon_start_margin"
                android:layout_marginEnd="@dimen/coll_swim_see_all_icon_end_margin"
                app:layout_constraintBottom_toTopOf="@+id/collectionSwimlaneSeeAllTextMobile"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/collection_swimlane_content_list_relative_layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="@dimen/coll_swim_see_all_text_size_mobile"
                android:textColor="@color/coll_swim_see_all_text_color"
                android:ellipsize="none"
                android:gravity="center"
                android:id="@+id/collectionSwimlaneSeeAllTextMobile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coll_swim_see_all_text_top_margin_mobile"
                android:singleLine="true"
                android:lineSpacingMultiplier="1.67"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/collectionSwimlaneSeeAllIcon"
                app:layout_constraintStart_toStartOf="@+id/collectionSwimlaneSeeAllIcon"
                app:layout_constraintTop_toBottomOf="@+id/collectionSwimlaneSeeAllIcon"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/seeAllButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="collectionSwimlaneSeeAllIcon,collectionSwimlaneSeeAllTextMobile"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
