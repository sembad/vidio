<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroBannerPlayerViewParentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <com.exoplayer2.player.exoPlayerUi.CustomSurfaceView
        android:id="@+id/playerSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/blackCurtain"
        android:background="#000000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/heroBannerImageView"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f0800b4"
        android:scaleType="fitEnd"
        android:adjustViewBounds="true"/>
    <TextView
        android:textColor="@android:color/transparent"
        android:id="@+id/playerState"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:text="0:NA:NA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
