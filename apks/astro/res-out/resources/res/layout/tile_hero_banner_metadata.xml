<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/tile_hero_banner_metadata"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="12sp"
            android:id="@+id/hero_banner_labels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.17"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/verticalGuideline"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AssetLabelDisplay"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/verticalGuideline"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.45"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="48dp"
        android:textColor="#ebebeb"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tile_metadata1_title"
        android:fadingEdgeLength="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:singleLine="false"
        android:lineSpacingExtra="10dp"
        android:requiresFadingEdge="horizontal"
        android:textAlignment="viewStart"
        android:layout_marginEnd="8dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never">
        <TextView
            android:textSize="16dp"
            android:textColor="#b2adaf"
            android:ellipsize="none"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tile_metadata1_third_line"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:textAlignment="viewStart"
            android:layout_marginEnd="4dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#bfffffff"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="#ebebeb"
        android:ellipsize="none"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tile_metadata_synopsis"
        android:fadingEdgeLength="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="3"
        android:singleLine="false"
        android:lineSpacingExtra="6dp"
        android:requiresFadingEdge="horizontal"
        android:textAlignment="viewStart"/>
    <include
        android:id="@+id/hero_banner_button"
        android:visibility="gone"
        layout="@layout/hero_banner_button"/>
</LinearLayout>
