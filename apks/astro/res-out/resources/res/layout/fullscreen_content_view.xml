<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/full_screen_content_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/full_content_tool_bar"
        layout="@layout/full_content_toolbar"/>
    <com.google.android.material.tabs.TabLayout
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:scrollbarTrackHorizontal="@+id/full_content_tab_layout"
        android:id="@+id/full_content_tab_layout"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/full_content_tool_bar"
        app:tabGravity="start"
        app:tabIndicatorColor="#ebebeb"
        app:tabIndicatorHeight="1dp"
        app:tabMinWidth="20dp"
        app:tabMode="scrollable"
        app:tabPadding="0dp"
        app:tabTextColor="#ebebeb"/>
    <View
        android:id="@+id/full_content_item_divider"
        android:background="#4debebeb"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/full_content_tab_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/full_content_tab_layout">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/filterMenuContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">
                <RelativeLayout
                    android:id="@+id/filterlayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/spinnerButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:id="@+id/filterMenuValueText"
                            android:paddingLeft="16dp"
                            android:paddingTop="8dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:maxLines="1"/>
                    </RelativeLayout>
                    <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                        android:gravity="end"
                        android:id="@+id/dropdownArrowIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/full_content_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <com.cisco.veop.client.widgets.BottomBarNavigationView
        android:id="@+id/bottom_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/full_content_tool_bar"
        layout="@layout/no_content_available"/>
</androidx.constraintlayout.widget.ConstraintLayout>
