<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false">
    <View
        android:id="@+id/mainPosterDummyPlaceholder"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="60dp"
        app:layout_constraintBottom_toTopOf="@+id/seriesEventTitle"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/topPartGradientTopAnchor"
        android:background="@android:color/transparent"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginBottom="70dp"
        app:layout_constraintBottom_toBottomOf="@+id/mainPosterDummyPlaceholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/topPartGradient"
        android:background="@drawable/title_and_metadata_gradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/watchInfoKey"
        app:layout_constraintTop_toTopOf="@+id/topPartGradientTopAnchor"/>
    <TextView
        android:textSize="10sp"
        android:id="@+id/seriesEventLabels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:lineSpacingMultiplier="1.17"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/seriesEventTitle"
        app:layout_constraintEnd_toEndOf="@+id/verticalGuideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainPosterDummyPlaceholder"
        style="@style/AssetLabelDisplay"/>
    <TextView
        android:textSize="24sp"
        android:id="@+id/seriesEventTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/seriesEventMetadataTopBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seriesEventLabels"
        app:layout_goneMarginTop="16dp"
        style="@style/SeriesPageEventTitle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/seriesEventMetadataTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="seriesEventMetadata,seriesEventParentalRatingIcon"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/seriesEventMetadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/watchInfoKey"
        app:layout_constraintEnd_toStartOf="@+id/seriesEventParentalRatingIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seriesEventTitle"
        style="@style/SeriesEventMetadata"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#b2adaf"
        android:gravity="center_vertical"
        android:id="@+id/seriesEventParentalRatingIcon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/seriesEventMetadata"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/seriesEventMetadata"
        app:layout_constraintTop_toTopOf="@+id/seriesEventMetadata"
        app:layout_goneMarginStart="16dp"
        app:layout_goneMarginTop="8dp"
        style="@style/RobotoBold"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/seriesEventMetadataBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="seriesEventMetadata,seriesEventParentalRatingIcon"/>
    <View
        android:id="@+id/topPartGradient2"
        android:background="@color/app_background_color"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/watchInfoKey"/>
    <TextView
        android:id="@+id/watchInfoKey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Start Watching"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoKeyValueSeparator"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seriesEventMetadataBottomBarrier"
        style="@style/WatchInfoKeyTextStyle"/>
    <TextView
        android:id="@+id/watchInfoKeyValueSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":"
        app:layout_constraintBottom_toBottomOf="@+id/watchInfoKey"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoValue"
        app:layout_constraintStart_toEndOf="@+id/watchInfoKey"
        app:layout_constraintTop_toTopOf="@+id/watchInfoKey"
        style="@style/WatchInfoKeyTextStyle"/>
    <TextView
        android:id="@+id/watchInfoValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/watchInfoKeyValueSeparator"
        app:layout_constraintTop_toTopOf="@+id/watchInfoKey"
        style="@style/WatchInfoValueTextStyle"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/watchInfoGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="watchInfoKey,watchInfoKeyValueSeparator,watchInfoValue"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/verticalGuideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.45"/>
</androidx.constraintlayout.widget.ConstraintLayout>
