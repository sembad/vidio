<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:background="#0e1019"
    android:visibility="invisible"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/movingToolbar"
            android:background="@color/toolbar_background_in_expanded_state"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:minHeight="?attr/actionBarSize"
            app:layout_scrollFlags="scroll">
            <TextView
                android:textSize="24sp"
                android:textColor="#ebebeb"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/backIconOfMovingToolbar"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="24sp"
                android:textColor="#ebebeb"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/searchIconOfMovingToolbar"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <ImageView
            android:id="@+id/mainPoster"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            app:layout_constraintDimensionRatio="H,2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/topScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/mainPosterDummyPlaceholder"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="H,2:3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/topPartGradientTopAnchor"
                    android:background="@android:color/transparent"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:layout_marginBottom="200dp"
                    app:layout_constraintBottom_toBottomOf="@+id/mainPosterDummyPlaceholder"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <include
                    android:id="@+id/astroMoviesPageTopPartUntilEventMetadata"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/continueWatchingSeekBarView"
                    app:layout_constraintTop_toBottomOf="@+id/topPartGradientTopAnchor"
                    layout="@layout/astro_movies_page_top_part_until_event_metadata"/>
                <View
                    android:id="@+id/bottomPartGradient"
                    android:background="@color/new_movies_page_translucent_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/astroMoviesPageTopPartUntilEventMetadata"/>
                <ProgressBar
                    android:id="@+id/continueWatchingSeekBarView"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/custom_progress_bar"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:progressTint="#e6007d"
                    android:progressBackgroundTint="#b3d8d8d8"
                    app:layout_constraintBottom_toTopOf="@+id/astroMoviesPageButtonsLayout"
                    app:layout_constraintTop_toBottomOf="@+id/astroMoviesPageTopPartUntilEventMetadata"
                    style="@style/ProgressBar"/>
                <include
                    android:id="@+id/astroMoviesPageButtonsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/astroMoviesPageTopPartFromSynopsisTillEnd"
                    app:layout_constraintTop_toBottomOf="@+id/continueWatchingSeekBarView"
                    app:layout_goneMarginTop="8dp"
                    layout="@layout/astro_movies_page_buttons"/>
                <include
                    android:id="@+id/astroMoviesPageTopPartFromSynopsisTillEnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/tabLayoutHolder"
                    app:layout_constraintTop_toBottomOf="@+id/astroMoviesPageButtonsLayout"
                    layout="@layout/astro_movies_page_top_part_from_synopsis_till_end"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tabLayoutHolder"
                    android:tag="@string/has_transparent_background_file_as_background_currently"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="1dp"
                    app:layout_constraintBottom_toTopOf="@+id/viewPager"
                    app:layout_constraintTop_toBottomOf="@+id/astroMoviesPageTopPartFromSynopsisTillEnd">
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:background="@android:color/transparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tabBackground="@android:color/transparent"
                        app:tabGravity="start"
                        app:tabIndicatorColor="@android:color/transparent"
                        app:tabMode="fixed"
                        app:tabSelectedTextColor="#ebebeb"
                        app:tabTextAppearance="@style/SeriesPageTabText"/>
                    <View
                        android:id="@+id/tabLayoutSeparator"
                        android:background="@drawable/ic_astro_tab_layout_separator"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/tab_layout_separator_height"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/tabLayoutHolder"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/stickyToolbar"
        android:background="@color/toolbar_background_in_non_expanded_state"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:minHeight="?attr/actionBarSize">
        <TextView
            android:textSize="24sp"
            android:textColor="#ebebeb"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/backIconOfStickyToolbar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="24sp"
            android:textColor="#ebebeb"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/searchIconOfStickyToolbar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"/>
    </androidx.appcompat.widget.Toolbar>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
