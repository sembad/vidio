<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:animateLayoutChanges="false">
    <com.google.android.material.card.MaterialCardView
        android:theme="@style/Theme.MaterialComponents.DayNight"
        android:id="@+id/ph_itemPosterCardView"
        android:layout_width="120dp"
        android:layout_height="68dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ph_itemPoster"
            android:background="@drawable/shimmer_effect_background_radius_8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
    </com.google.android.material.card.MaterialCardView>
    <include
        android:id="@+id/ph_itemTitleAndMetadataLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/ph_posterAndTitleBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ph_itemPosterCardView"
        app:layout_constraintTop_toTopOf="@+id/ph_itemPosterCardView"
        layout="@layout/shimmer_placeholder_for_item_title_and_metadata"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/ph_posterAndTitleBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ph_itemPosterCardView,ph_itemTitleAndMetadataLayout"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ebebeb"
        android:id="@+id/ph_itemSynopsis_Line1"
        android:background="@drawable/shimmer_effect_background_radius_4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ph_posterAndTitleBarrier"
        style="@style/RobotoRegular"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ebebeb"
        android:id="@+id/ph_itemSynopsis_Line2"
        android:background="@drawable/shimmer_effect_background_radius_4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginEnd="28.7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ph_itemSynopsis_Line1"
        style="@style/RobotoRegular"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ebebeb"
        android:id="@+id/ph_itemSynopsis_Line3"
        android:background="@drawable/shimmer_effect_background_radius_4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginEnd="81.2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ph_itemSynopsis_Line2"
        style="@style/RobotoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
