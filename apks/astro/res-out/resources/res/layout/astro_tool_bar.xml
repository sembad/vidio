<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0e1019"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <TextView
        android:textSize="24sp"
        android:textColor="#ebebeb"
        android:id="@+id/backIconOfStationaryToolbar"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textColor="#ebebeb"
        android:id="@+id/searchIconOfStationaryToolbar"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/childViewsOfStationaryToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="backIconOfStationaryToolbar, searchIconOfStationaryToolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
