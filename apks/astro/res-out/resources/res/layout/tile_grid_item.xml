<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_grid_swim_lane_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_poster_layout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:minWidth="@dimen/tile_grid_poster_width"
        app:cardCornerRadius="@dimen/tile_grid_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/tile_grid_poster_width"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/tile_poster"
                android:layout_width="@dimen/tile_grid_poster_width"
                android:layout_height="0dp"
                android:minWidth="@dimen/tile_grid_poster_width"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tile_poster_gradient"
                android:background="@drawable/tile_poster_gradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignBottom="@+id/tile_poster"/>
            <View
                android:background="@color/grid_poster_mask_color"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ProgressBar
                android:id="@+id/tile_progress_bar"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_progress_bar_height"
                android:max="100"
                android:indeterminate="false"
                android:progressDrawable="@drawable/custom_progress_bar"
                android:progressTint="#e6007d"
                android:progressBackgroundTint="#b3d8d8d8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp">
                <TextView
                    android:textSize="25dp"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/title_grid_record_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="@dimen/tile_grid_meta_data_top_margin"
                    android:includeFontPadding="false"
                    android:layout_toStartOf="@+id/tile_asset_labels"/>
                <TextView
                    android:textSize="10sp"
                    android:id="@+id/tile_asset_labels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_alignParentRight="true"
                    android:lineSpacingMultiplier="1.17"
                    android:layout_marginEnd="4dp"
                    style="@style/AssetLabelDisplay"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/channel_logo_icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tile_grid_meta_data_left_margin"
        android:layout_marginTop="@dimen/tile_grid_meta_data_top_margin"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        android:maxHeight="@dimen/tile_channel_logo_height"
        android:minHeight="@dimen/tile_channel_logo_height"
        app:layout_constraintLeft_toRightOf="@+id/card_view_poster_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/tile_grid_meta_data_title_text_size"
        android:textColor="@color/tile_grid_meta_data_title_color"
        android:ellipsize="none"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tile_metadata1_title"
        android:fadingEdgeLength="40dp"
        android:layout_width="@dimen/tile_grid_meta_data_title_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tile_grid_meta_data_left_margin"
        android:layout_marginTop="@dimen/tile_grid_meta_data_top_margin"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:textAlignment="viewStart"
        app:layout_constraintLeft_toRightOf="@+id/card_view_poster_layout"
        app:layout_constraintTop_toBottomOf="@+id/channel_logo_icon"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="@dimen/tile_grid_meta_data_title_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tile_grid_meta_data_left_margin"
        android:layout_marginTop="@dimen/tile_grid_meta_data_top_margin"
        android:overScrollMode="never"
        app:layout_constraintLeft_toRightOf="@+id/card_view_poster_layout"
        app:layout_constraintTop_toBottomOf="@+id/tile_metadata1_title">
        <TextView
            android:textSize="12sp"
            android:textColor="#b2adaf"
            android:ellipsize="none"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tile_metadata1_third_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:layout_marginEnd="4dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#b2adaf"
            android:ellipsize="none"
            android:gravity="center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="3dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
