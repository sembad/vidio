<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents.DayNight"
    android:id="@+id/itemParentLayout"
    android:layout_width="160dp"
    android:layout_height="90dp"
    android:layout_centerHorizontal="true"
    android:layout_marginEnd="@dimen/horizontal_swimlane_item_end_margin"
    app:cardCornerRadius="@dimen/tile_collection_swimlane_item_corner_radius"
    app:cardElevation="@dimen/tile_collection_swimlane_item_card_elevation">
    <ImageView
        android:id="@+id/itemPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f0800b4"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <View
        android:id="@+id/poster_gradient"
        android:background="@drawable/tile_genre_poster_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ebebeb"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/itemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.4"
        android:textAlignment="center"
        style="@style/RobotoBold"/>
</com.google.android.material.card.MaterialCardView>
