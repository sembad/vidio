<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_hero_banner_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:theme="@style/Theme.MaterialComponents.Light"
        android:id="@+id/container_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="13dp"
        android:layout_centerHorizontal="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="14dp"
        app:strokeColor="#7fffffff"
        app:strokeWidth="1dp">
        <RelativeLayout
            android:id="@+id/container_view_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/tile_poster_default_text_size_hero_banner"
                android:textColor="@android:color/darker_gray"
                android:gravity="center_vertical"
                android:id="@+id/tile_event_default_text"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tile_poster_hero_banner_height"
                android:layout_alignBottom="@+id/toolbar"
                android:lineSpacingMultiplier="0.57"/>
            <ImageView
                android:id="@+id/tile_poster"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tile_poster_hero_banner_height"
                android:scaleType="fitXY"/>
            <View
                android:id="@+id/tile_poster_gradient"
                android:background="@drawable/tile_poster_gradient_1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tile_poster_hero_banner_height"
                android:layout_alignBottom="@+id/tile_poster"/>
            <ImageView
                android:id="@+id/tile_poster_center_icon"
                android:layout_width="47dp"
                android:layout_height="47dp"
                android:layout_centerInParent="true"/>
            <ProgressBar
                android:id="@+id/tile_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progress="20"
                android:indeterminate="false"
                android:layout_alignLeft="@+id/tile_poster"
                android:layout_alignBottom="@+id/tile_poster"
                android:layout_centerHorizontal="true"
                style="@style/ProgressBar"/>
            <ImageView
                android:id="@+id/channel_logo_icon"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tile_poster_download_icon_height"
                android:layout_alignTop="@+id/tile_metadata_container"/>
            <include
                android:id="@+id/tile_metadata_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/tile_poster"
                layout="@layout/tile_metadata1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heroBannerAssetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_above="@+id/tile_metadata_container"
                android:layout_marginEnd="8dp">
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/hero_banner_labels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.17"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="@+id/verticalGuideline"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/AssetLabelDisplay"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/verticalGuideline"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:layout_constraintGuide_percent="0.45"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/top_glint_effect_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/glint_effect"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:translationZ="90dp"/>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/bottom_glint_effect_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:src="@drawable/glint_effect"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:translationZ="90dp"/>
</RelativeLayout>
