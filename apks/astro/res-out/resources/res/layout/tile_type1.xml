<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/tile_type1_layout"
    android:layout_width="@dimen/tile_type1_width"
    android:layout_height="match_parent"
    android:layout_centerHorizontal="true"
    app:cardCornerRadius="8dp"
    app:cardElevation="10dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/tile_poster_default_text_size"
            android:textColor="@android:color/darker_gray"
            android:gravity="center_vertical"
            android:id="@+id/tile_event_default_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tile_poster_height"
            android:lineSpacingMultiplier="0.55"/>
        <ImageView
            android:id="@+id/tile_poster"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tile_poster_height"
            android:scaleType="fitXY"/>
        <View
            android:id="@+id/tile_poster_gradient"
            android:background="@drawable/tile_poster_gradient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tile_poster_height"
            android:layout_alignBottom="@+id/tile_poster"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/tile_item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/tile_poster">
            <TextView
                android:textSize="12sp"
                android:textColor="#b3ebebeb"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tile_item"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="@dimen/two_line_metadata_padding_from_start"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#b3ebebeb"
                    android:ellipsize="none"
                    android:id="@+id/tile_item_second_line"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:paddingStart="@dimen/two_line_metadata_padding_from_start"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#bfffffff"
                    android:ellipsize="none"
                    android:id="@+id/tile_item_second_line_icons"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tile_item_second_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tile_item_second_line"
                    app:layout_constraintTop_toTopOf="@+id/tile_item_second_line"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/tile_poster_center_icon"
            android:layout_width="@dimen/tile_poster_center_icon_width"
            android:layout_height="@dimen/tile_poster_center_icon_height"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/channel_logo_icon"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tile_poster_channel_logo_height"
            android:layout_marginBottom="@dimen/tile_channel_logo_margin_bottom"
            android:adjustViewBounds="true"
            android:layout_alignBottom="@+id/tile_poster"
            android:layout_marginEnd="@dimen/tile_channel_logo_margin_end"
            android:layout_alignParentEnd="true"/>
        <include
            android:id="@+id/tile_metadata_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/tile_poster"
            layout="@layout/tile_metadata1"/>
        <ProgressBar
            android:id="@+id/tile_progress_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tile_progress_bar_height"
            android:layout_marginBottom="8px"
            android:max="100"
            android:progress="20"
            android:indeterminate="false"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:layout_alignParentBottom="true"
            android:progressTint="#e6007d"
            android:progressBackgroundTint="#b3d8d8d8"
            style="@style/ProgressBar"/>
        <ImageView
            android:id="@+id/channel_logo_icon_for_search_result_screen"
            android:visibility="gone"
            android:layout_width="@dimen/enhanced_search_poster_width"
            android:layout_height="@dimen/enhanced_search_poster_height"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:layout_above="@+id/tile_item_layout"
            android:paddingStart="@dimen/two_line_metadata_padding_from_start"
            android:layout_alignStart="@+id/tile_item_layout"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:id="@+id/iconsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.cisco.veop.client.kiott.customviews.OrangeDownloadStatusIcon
                    android:id="@+id/txt_download_glyph_status"
                    android:visibility="gone"
                    android:layout_width="@dimen/tile_poster_download_icon_width"
                    android:layout_height="@dimen/tile_poster_download_icon_height"
                    android:layout_marginTop="@dimen/tile_poster_download_icon_top"
                    android:layout_marginEnd="@dimen/tile_poster_download_icon_end"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/title_grid_record_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="25sp"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/title_grid_record_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="@dimen/tile_grid_meta_data_top_margin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/txt_download_glyph_status"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="10sp"
                android:id="@+id/tile_asset_labels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_alignParentRight="true"
                android:lineSpacingMultiplier="1.17"
                android:layout_marginEnd="4dp"
                style="@style/AssetLabelDisplay"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
