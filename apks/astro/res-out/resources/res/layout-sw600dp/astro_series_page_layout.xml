<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:background="@color/app_background_color"
    android:visibility="invisible"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/some_random_height_for_scrolling_animation_in_negative">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:background="@color/app_background_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/some_random_height_for_scrolling_animation_in_negative"
        app:layout_anchor="@+id/appBarLayout"
        app:layout_anchorGravity="bottom"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <ImageView
        android:layout_gravity="bottom|right"
        android:id="@+id/takeMeToTheTopButton"
        android:background="@drawable/scroll_to_top_background"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginBottom="150dp"
        android:src="@drawable/ic_scroll_to_top_new"
        android:layout_marginEnd="41dp"
        app:layout_anchorGravity="end|bottom"/>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.cisco.veop.client.newSeriesPage.utils.AppBarLayoutBehavior">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbarLayout"
            android:background="@android:color/transparent"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlwaysCollapsed|enterAlways|scroll"
            app:statusBarScrim="@android:color/transparent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/topScrollView"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@android:color/transparent"
                    android:paddingBottom="32dp"
                    android:fitsSystemWindows="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/mainPosterContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginTop="84dp"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.card.MaterialCardView
                            android:theme="@style/Theme.MaterialComponents.DayNight"
                            android:id="@+id/mainPosterCardView"
                            android:layout_width="316dp"
                            android:layout_height="180dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:id="@+id/mainPoster"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:adjustViewBounds="true"/>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <include
                        android:id="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="84dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="90dp"
                        app:layout_constraintBottom_toTopOf="@+id/astroSeriesPageTopPartFromSynopsisTillEnd"
                        app:layout_constraintEnd_toStartOf="@+id/mainPosterContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/astro_series_page_top_part_until_event_metadata"/>
                    <include
                        android:id="@+id/astroSeriesPageTopPartFromSynopsisTillEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/continueWatchingSeekBarView"
                        app:layout_constraintEnd_toEndOf="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        app:layout_constraintStart_toStartOf="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        app:layout_constraintTop_toBottomOf="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        layout="@layout/astro_series_page_top_part_from_synopsis_till_end"/>
                    <ProgressBar
                        android:id="@+id/continueWatchingSeekBarView"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/custom_progress_bar"
                        android:layout_marginEnd="16dp"
                        android:progressTint="#e6007d"
                        android:progressBackgroundTint="#b3d8d8d8"
                        app:layout_constraintBottom_toTopOf="@+id/astroSeriesPageButtonsLayout"
                        app:layout_constraintStart_toStartOf="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        app:layout_constraintTop_toBottomOf="@+id/astroSeriesPageTopPartFromSynopsisTillEnd"
                        app:layout_constraintWidth_percent="0.32"
                        style="@style/ProgressBar"/>
                    <include
                        android:id="@+id/astroSeriesPageButtonsLayout"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        app:layout_constraintStart_toStartOf="@+id/astroSeriesPageTopPartUntilEventMetadata"
                        app:layout_constraintTop_toBottomOf="@+id/continueWatchingSeekBarView"
                        layout="@layout/astro_series_page_buttons"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/movingToolbar"
                android:background="@color/toolbar_background_in_expanded_state"
                android:visibility="visible"
                android:fitsSystemWindows="true"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:minHeight="?attr/actionBarSize"
                app:layout_collapseMode="pin">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp">
                    <View
                        android:id="@+id/clickableAreaOfBackIconOfMovingToolbar"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textSize="24sp"
                        android:textColor="#ebebeb"
                        android:id="@+id/backIconOfMovingToolbar"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/clickableAreaOfSearchIconOfMovingToolbar"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView
                        android:textSize="24sp"
                        android:textColor="#ebebeb"
                        android:id="@+id/searchIconOfMovingToolbar"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tabLayoutHolder"
            android:tag="@string/has_transparent_background_file_as_background_currently"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="1dp"
            app:layout_scrollFlags="exitUntilCollapsed">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabBackground="@android:color/transparent"
                app:tabGravity="start"
                app:tabIndicatorColor="@android:color/transparent"
                app:tabMode="fixed"
                app:tabPaddingBottom="18dp"
                app:tabPaddingTop="10dp"
                app:tabSelectedTextColor="#ebebeb"
                app:tabTextAppearance="@style/SeriesPageTabTextInTablets"/>
            <View
                android:id="@+id/tabLayoutSeparator"
                android:background="#474747"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_layout_separator_height"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
