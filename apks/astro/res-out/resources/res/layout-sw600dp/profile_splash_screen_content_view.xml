<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_screen_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toTopOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/avatarLayoutId"
        android:background="@drawable/profile_image_white_shaded_background"
        android:layout_width="500dp"
        android:layout_height="500dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.253">
        <com.cisco.veop.client.userprofile.screens.CircularImageView
            android:id="@+id/profile_avatar_content_item_image_view"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/default_profile_add"
            android:tint="#6f000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="24dp"
            android:textColor="#ebebeb"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/profile_name_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/profile_avatar_content_item_image_view"
            app:layout_constraintStart_toStartOf="@+id/profile_avatar_content_item_image_view"
            app:layout_constraintTop_toBottomOf="@+id/profile_avatar_content_item_image_view"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#ebebeb"
            android:gravity="center_horizontal"
            android:id="@+id/profile_age_display_string"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/profile_name_view"/>
        <TextView
            android:textSize="50dp"
            android:textColor="#ebebeb"
            android:gravity="center_horizontal"
            android:id="@+id/splash_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="Hello"
            app:layout_constraintBottom_toTopOf="@+id/profile_avatar_content_item_image_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="#b3ebebeb"
        android:gravity="center_horizontal"
        android:id="@+id/profile_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="120dp"
        android:text="Profile created successfully"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatarLayoutId"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
