<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seriesTabFragmentParentLayout"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/shimmerFrameLayoutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/shimmer_placeholder_for_series_page_fragment"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/seasonItemsRecyclerView"
        android:paddingBottom="@dimen/some_random_height_for_scrolling_animation"
        android:clipToPadding="false"
        android:layout_width="189dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/total_sum_of_random_height_for_scrolling_animation_plus_season_items_recycler_view_top_margin"
        android:minHeight="1000dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toStartOf="@+id/seriesItemsRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/seriesItemsRecyclerView"
        android:paddingTop="@dimen/some_random_height_for_scrolling_animation"
        android:paddingBottom="@dimen/some_random_height_for_scrolling_animation"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:minHeight="1000dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/seasonItemsRecyclerView"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/seasonItemsListAndSeriesItemsList"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="seasonItemsRecyclerView,seriesItemsRecyclerView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
