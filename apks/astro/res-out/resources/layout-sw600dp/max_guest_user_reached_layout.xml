<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_color">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/hamburger_logo"
        android:layout_marginTop="18dp"
        android:layout_marginStart="51dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/max_user_exceeded_title"
            style="@style/MaxUserExceededTitleForTablet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Maximum user Exceeded"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/max_user_exceeded_description"
            style="@style/MaxUserExceededDescriptionForTablet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="11dp"
            android:layout_marginStart="221dp"
            android:layout_marginEnd="221dp"
            tools:text="Too many concurrent guest users. Try again tomorrow. Login with your ID if you are an existing subscriber and logged out."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/max_user_exceeded_button"
            app:layout_constraintTop_toBottomOf="@id/max_user_exceeded_title"/>

        <Button
            android:id="@+id/max_user_exceeded_button"
            style="@style/MaxUserExceededLoginButton"
            android:foreground="@drawable/secondary_buttons_ripple_animation"
            android:background="@drawable/max_user_limit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="23dp"
            android:paddingEnd="23dp"
            android:text="Login"
            android:layout_marginTop="40dp"
            android:layout_marginStart="403dp"
            android:layout_marginEnd="402dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/max_user_exceeded_description"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
