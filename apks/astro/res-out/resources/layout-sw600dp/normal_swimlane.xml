<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp">

    <TextView
        android:id="@+id/swimLaneTitle"
        style="@style/SwimLaneItemTitleStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hub_screen_swimlane_gap_from_start_or_end"
        android:layout_marginEnd="@dimen/gap_between_title_and_see_all_text"
        app:layout_constraintEnd_toStartOf="@+id/swimLaneSeeAll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="SwimLane Title Is Tooooooooooo o Longggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg" />

    <TextView
        android:id="@+id/swimLaneSeeAll"
        style="@style/SwimLaneItemSeeAllStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/hub_screen_swimlane_gap_from_start_or_end"
        app:layout_constraintBaseline_toBaselineOf="@+id/swimLaneTitle"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="See All"
        tools:textColor="#ffffff"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/swimLaneItemsList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/hub_screen_swimlane_gap_from_start_or_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/swimLaneTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
