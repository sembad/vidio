<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theEpisodeItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:animateLayoutChanges="false"
    android:foreground="@drawable/season_list_spinner_ripple_animation"
    tools:background="#0e1019">

    <View
        android:id="@+id/isTablet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemPosterCardView"
        android:layout_width="211dp"
        android:layout_height="119dp"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/itemPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:foreground="@drawable/item_poster_ripple_animation"
            tools:src="@drawable/default_event_bitmap_linear_landscape" />

        <TextView
            android:id="@+id/episodeLabel"
            style="@style/AssetLabelDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:lineSpacingMultiplier="1.2"
            android:textSize="10sp"
            tools:text="New Episode Blah Blah Blah Blah blah blah blah blah"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/continueWatchingSeekBarView"
            style="@style/ProgressBar"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:indeterminate="false"
            android:progressBackgroundTint="#B3D8D8D8"
            android:progressTint="#e6007d"
            android:visibility="gone"
            tools:visibility="visible"/>

    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/itemTitleAndMetadataLayout"
        layout="@layout/item_title_and_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/endViewsBarrier"
        app:layout_constraintStart_toEndOf="@+id/itemPosterCardView"
        app:layout_constraintTop_toTopOf="@+id/itemPosterCardView" />


    <TextView
        android:id="@+id/itemSynopsis"
        style="@style/RobotoRegular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="#ebebeb"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemPosterCardView"
        app:layout_constraintTop_toBottomOf="@+id/itemTitleAndMetadataLayout"
        tools:text="Test Test Test Test Test Test Tested Test Test Test Test Test Testing Test Test" />


    <com.cisco.veop.client.newSeriesPage.screens.ui.downloadStatusSpinner.DownloadStatusSpinner
        android:id="@+id/downloadStatusSpinner"
        android:layout_width="296dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:background="@android:color/transparent"
        android:enabled="false"
        android:popupBackground="@drawable/download_status_spinner_background"
        android:spinnerMode="dropdown"
        app:layout_constraintEnd_toEndOf="@+id/downloadStatusContainer"
        app:layout_constraintTop_toBottomOf="@+id/downloadStatusContainer"
        tools:contentDescription="setting enabled to false in only XML won't work. you need to do it programatically in Kotlin code inside SeriesItemsRecyclerViewAdapter" />

    <!--  Purpose of having transparent background on Spinner is to
       hide the drop down arrow of Spinner : android:background="@android:color/transparent"-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fetchMoreInfoProgressBar"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemSynopsis">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/topMostViewInExpandedState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/itemSynopsis"
        app:layout_constraintTop_toBottomOf="@+id/itemSynopsis" />

    <TextView
        android:id="@+id/itemCastInfo"
        style="@style/EpisodeItemCastInfoValueTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/itemDirectorInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/itemSynopsis"
        app:layout_constraintTop_toBottomOf="@+id/topMostViewInExpandedState"
        tools:text="Cast: Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test" />

    <TextView
        android:id="@+id/itemDirectorInfo"
        style="@style/EpisodeItemDirectorInfoValueTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/itemAudioInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/itemSynopsis"
        app:layout_constraintTop_toBottomOf="@+id/itemCastInfo"
        tools:text="Director: Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test" />

    <TextView
        android:id="@+id/itemAudioInfo"
        style="@style/EpisodeItemAudioInfoValueTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/itemSubtitleInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/itemSynopsis"
        app:layout_constraintTop_toBottomOf="@+id/itemDirectorInfo"
        tools:text="Audio: Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test" />

    <TextView
        android:id="@+id/itemSubtitleInfo"
        style="@style/EpisodeItemSubtitlesInfoValueTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/showLessButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/itemSynopsis"
        app:layout_constraintTop_toBottomOf="@+id/itemAudioInfo"
        tools:text="Subtitle: Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test" />

    <TextView
        android:id="@+id/showLessButton"
        style="@style/EpisodeItemShowMoreTextStyleTablet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:contentDescription="Show More Or Less. After clicking Show More, all collapsed items will be expanded and vice-versa"
        android:text="@string/show_less_hint_for_item"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/itemSynopsis"
        app:layout_constraintTop_toBottomOf="@+id/itemSubtitleInfo" />


    <ImageView
        android:id="@+id/threeDotsIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_three_dots"
        app:layout_constraintBottom_toBottomOf="@+id/itemTitleAndMetadataLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/itemTitleAndMetadataLayout" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/downloadStatusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/itemTitleAndMetadataLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/itemTitleAndMetadataLayout">

        <com.cisco.veop.client.kiott.customviews.NewDownloadStatusIcon2
            android:id="@+id/downloadStatusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/downloadStatusPercentage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />


        <TextView
            android:id="@+id/downloadStatusPercentage"
            style="@style/RobotoRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#d8d8d8"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/downloadStatusIcon"
            tools:text="25%" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/endViewsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="threeDotsIcon,downloadStatusContainer" />


</androidx.constraintlayout.widget.ConstraintLayout>
