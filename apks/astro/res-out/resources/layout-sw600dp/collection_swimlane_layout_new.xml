<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collection_swimlane_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/collection_swimlane_layout_height_tablet"
    android:foreground="@drawable/rectangular_ripple_animation"
    android:layout_marginBottom="@dimen/collection_swimlane_layout_bottom_margin_tablet">

    <ImageView
        android:id="@+id/collectionSwimlanePoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_thirty_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <TextView
        android:id="@+id/collection_swimlane_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.2"
        android:shadowColor="@color/collection_swimlane_title_shadow_color"
        android:shadowDx="0.0"
        android:shadowDy="2.0"
        android:shadowRadius="4.0"
        android:singleLine="true"
        android:textColor="@color/collection_swimlane_title_color"
        android:textSize="@dimen/collection_swimlane_title_text_size_tablet"
        app:layout_constraintBottom_toTopOf="@+id/collection_swimlane_content_list"
        app:layout_constraintEnd_toStartOf="@+id/collectionSwimlaneSeeAllTextTablet"
        app:layout_constraintStart_toStartOf="@+id/guideline_thirty_percent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="The Harry Potter Collection Too Long Title" />

    <TextView
        android:id="@+id/collectionSwimlaneSeeAllTextTablet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/coll_swim_see_all_text_end_margin_tablet"
        android:foreground="@drawable/ripple_animation"
        android:background="@drawable/ic_see_all_background_tablet"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="@dimen/coll_swim_see_all_text_start_padding_tablet"
        android:paddingTop="@dimen/coll_swim_see_all_text_top_padding_tablet"
        android:paddingEnd="@dimen/coll_swim_see_all_text_end_padding_tablet"
        android:paddingBottom="@dimen/coll_swim_see_all_text_bottom_padding_tablet"
        android:textColor="@color/coll_swim_see_all_text_color"
        android:textSize="@dimen/coll_swim_see_all_text_size_tablet"
        app:layout_constraintBottom_toBottomOf="@+id/collection_swimlane_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/collection_swimlane_title"
        app:layout_constraintTop_toTopOf="@+id/collection_swimlane_title"
        tools:text="See All Long" />

    <!--    android:lineSpacingMultiplier="1.34" : purpose is to have lineHeight of 32sp. Zeplin says that lineHeight = 32dp and textSize = 24sp, lineSpacingMultiplier = lineHeight/textSize  -->


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/collection_swimlane_content_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingEnd="@dimen/collection_swimlane_list_end_padding_tablet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline_thirty_percent"
        app:layout_constraintTop_toBottomOf="@+id/collection_swimlane_title"
        tools:ignore="RtlSymmetry" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/seeAllButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="collectionSwimlaneSeeAllTextTablet" />


    <!--    android:clipToPadding="false" - it will help to have padding of 16dp towards start and end of recycler
    view and at the same time recycler view will start at the left edge of parent clipping any kind of padding at start,
    can be verified while scrolling-->

</androidx.constraintlayout.widget.ConstraintLayout>


