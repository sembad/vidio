<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerFrameLayoutScroller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/some_random_height_for_scrolling_animation"
    android:paddingBottom="@dimen/some_random_height_for_scrolling_animation">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:orientation="vertical"
        app:shimmer_auto_start="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/phSeasonItemsRecyclerView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="40dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/phSeriesItemsRecyclerView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

                <include layout="@layout/shimmer_placeholder_for_season_list_recycler_view_item" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/phSeriesItemsRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/phSeasonItemsRecyclerView"
                app:layout_constraintTop_toTopOf="parent">

                <include layout="@layout/shimmer_placeholder_for_series_tab_list_item" />

                <include layout="@layout/shimmer_placeholder_for_series_tab_list_item" />

                <include layout="@layout/shimmer_placeholder_for_series_tab_list_item" />

                <include layout="@layout/shimmer_placeholder_for_series_tab_list_item" />

                <include layout="@layout/shimmer_placeholder_for_series_tab_list_item" />

                <include layout="@layout/shimmer_placeholder_for_series_tab_list_item" />

                <include layout="@layout/shimmer_placeholder_for_series_tab_list_item" />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.core.widget.NestedScrollView>
