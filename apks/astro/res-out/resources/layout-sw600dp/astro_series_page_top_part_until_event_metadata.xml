<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false"
    tools:background="#0e1019">

    <TextView
        android:id="@+id/seriesEventLabels"
        style="@style/AssetLabelDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="New Season"
        tools:visibility="visible"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        app:layout_constrainedWidth="true"
        android:lineSpacingMultiplier="1.17"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintEnd_toEndOf="@id/verticalGuideline"
        app:layout_constraintBottom_toTopOf="@+id/seriesEventTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent" />

    <TextView
        android:id="@+id/seriesEventTitle"
        style="@style/SeriesPageEventTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textSize="40sp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/seriesEventMetadataTopBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seriesEventLabels"
        tools:contentDescription="@string/visibility_warning"
        tools:text="Game of Thrones Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/seriesEventMetadataTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:layout_constraintTop_toBottomOf="@+id/seriesEventTitle"
        app:constraint_referenced_ids="seriesEventMetadata, seriesEventParentalRatingIcon, seriesEventResolutionIcon" />

    <TextView
        android:id="@+id/seriesEventMetadata"
        style="@style/SeriesEventMetadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:textSize="16sp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/seriesEventParentalRatingIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seriesEventTitle"
        tools:text="8 Seasons | 2018 | Action, Drama | Test Test Test" />

    <TextView
        android:id="@+id/seriesEventParentalRatingIcon"
        style="@style/RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.3"
        android:textColor="#b2adaf"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/seriesEventMetadata"
        app:layout_constraintEnd_toStartOf="@+id/seriesEventResolutionIcon"
        app:layout_constraintStart_toEndOf="@+id/seriesEventMetadata"
        app:layout_constraintTop_toTopOf="@+id/seriesEventMetadata"
        app:layout_goneMarginTop="8dp"
        tools:text="18" />

    <TextView
        android:id="@+id/seriesEventResolutionIcon"
        style="@style/RobotoBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.3"
        android:textColor="#b2adaf"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/seriesEventMetadata"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/seriesEventParentalRatingIcon"
        app:layout_constraintTop_toTopOf="@+id/seriesEventMetadata"
        app:layout_goneMarginTop="8dp"
        tools:text="HD" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/seriesEventMetadataBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="seriesEventMetadata,seriesEventParentalRatingIcon, seriesEventResolutionIcon" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verticalGuideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

</androidx.constraintlayout.widget.ConstraintLayout>
