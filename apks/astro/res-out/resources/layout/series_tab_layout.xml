<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/seriesTabFragmentParentLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <include
        android:id="@+id/shimmerFrameLayoutContainer"
        layout="@layout/shimmer_placeholder_for_series_page_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/seriesItemsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        android:clipToPadding="false"
        android:minHeight="1000dp"
        android:paddingTop="@dimen/some_random_height_for_scrolling_animation"
        android:paddingBottom="@dimen/some_random_height_for_scrolling_animation"
        app:layout_constraintTop_toTopOf="parent"
        tools:contentDescription="Since it's parent container which is ViewPager, has top margin of -200dp, it should have same amount of positive top padding i.e +200dp " />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stickyGradientAtTopContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/some_random_height_for_scrolling_animation"
        app:layout_constraintTop_toTopOf="parent"
        tools:contentDescription="Since it's parent container which is ViewPager has top margin of -200dp, it should have same amount of positive top padding i.e +200dp ">

        <ImageView
            android:id="@+id/stickyGradientAtTop"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:src="@drawable/toolbar_gradient"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="@dimen/some_random_height_for_scrolling_animation"
        app:layout_constraintTop_toTopOf="parent"
        tools:contentDescription="Since it's parent container which is ViewPager has top margin of -200dp, it should have same amount of positive top padding i.e +200dp ">

        <ImageView
            android:id="@+id/spinnerBackground"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/season_list_spinner_ripple_animation"
            android:src="@drawable/season_list_spinner_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/spinnerText"
            style="@style/SeasonNumberOfSeasonListSpinnerStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="#ebebeb"
            android:textSize="16sp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/openSpinnerIcon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Season 1" />

        <ImageView
            android:id="@+id/openSpinnerIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_arrow_pointing_down"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/seasonItemsListAndSeriesItemsList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="spinner,seriesItemsRecyclerView" />


</androidx.constraintlayout.widget.ConstraintLayout>

