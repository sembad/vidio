<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/show_more_dialog_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:paddingStart="142dp"
        android:paddingTop="181dp"
        android:paddingEnd="142dp"
        android:paddingBottom="181dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center">

            <TextView
                android:id="@+id/titleInfoKey"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="171dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                app:layout_constraintEnd_toStartOf="@+id/titleInfoKeyValueSeparator"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Title" />

            <TextView
                android:id="@+id/titleInfoKeyValueSeparator"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                app:layout_constraintEnd_toStartOf="@+id/titleInfoValueContainer"
                app:layout_constraintStart_toEndOf="@+id/titleInfoKey"
                app:layout_constraintTop_toTopOf="@+id/titleInfoKey" />

            <include
                android:id="@+id/titleInfoValueContainer"
                layout="@layout/show_more_dialog_title_and_metadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/titleInfoKeyValueSeparator"
                app:layout_constraintTop_toTopOf="@+id/titleInfoKey" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/titleInfoBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="titleInfoKey,titleInfoKeyValueSeparator,titleInfoValueContainer" />


            <TextView
                android:id="@+id/synopsisInfoKey"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="171dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                app:layout_constraintEnd_toStartOf="@+id/synopsisInfoKeyValueSeparator"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleInfoBarrier"
                tools:text="Synopsis Key is too long. This is how it should be aligned with it's value which is situated on it's right hand side" />

            <TextView
                android:id="@+id/synopsisInfoKeyValueSeparator"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                app:layout_constraintEnd_toStartOf="@+id/synopsisInfoValue"
                app:layout_constraintStart_toEndOf="@+id/synopsisInfoKey"
                app:layout_constraintTop_toTopOf="@+id/synopsisInfoKey" />

            <TextView
                android:id="@+id/synopsisInfoValue"
                style="@style/ShowMoreDialogValueTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/synopsisInfoKeyValueSeparator"
                app:layout_constraintTop_toTopOf="@+id/synopsisInfoKey"
                tools:text="Short Synopsis" />


            <androidx.constraintlayout.widget.Group
                android:id="@+id/synopsisInfoGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="synopsisInfoKey,synopsisInfoKeyValueSeparator,synopsisInfoValue"
                tools:contentDescription="@string/visibility_warning" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/synopsisInfoBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="synopsisInfoKey,synopsisInfoKeyValueSeparator,synopsisInfoValue" />

            <TextView
                android:id="@+id/castInfoKey"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="171dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                app:layout_constraintEnd_toStartOf="@+id/castInfoKeyValueSeparator"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/synopsisInfoBarrier"
                tools:text="Cast" />

            <TextView
                android:id="@+id/castInfoKeyValueSeparator"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                app:layout_constraintEnd_toStartOf="@+id/castInfoValue"
                app:layout_constraintStart_toEndOf="@+id/castInfoKey"
                app:layout_constraintTop_toTopOf="@+id/castInfoKey" />

            <TextView
                android:id="@+id/castInfoValue"
                style="@style/ShowMoreDialogValueTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/castInfoKeyValueSeparator"
                app:layout_constraintTop_toTopOf="@+id/castInfoKey"
                tools:text="Bruce Willis, Haley Joel Osment, Toni Collette, Olivia Williams, Trevor Morgan Test Test Test test Test test Test Bruce Willis, Haley Joel Osment, Toni Collette, Olivia Williams, Trevor Morgan Test Test Test test Test test Test Bruce Willis, Haley Joel Osment, Toni Collette, Olivia Williams, Trevor Morgan Test Test Test test Test test Test " />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/castInfoGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="castInfoKey,castInfoKeyValueSeparator,castInfoValue"
                tools:contentDescription="@string/visibility_warning" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/castInfoBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="castInfoKey,castInfoKeyValueSeparator,castInfoValue" />


            <TextView
                android:id="@+id/directorInfoKey"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="171dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                app:layout_constraintEnd_toStartOf="@+id/directorInfoKeyValueSeparator"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/castInfoBarrier"
                tools:text="Director" />

            <TextView
                android:id="@+id/directorInfoKeyValueSeparator"
                style="@style/ShowMoreDialogKeyTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                app:layout_constraintEnd_toStartOf="@+id/directorInfoValue"
                app:layout_constraintStart_toEndOf="@+id/directorInfoKey"
                app:layout_constraintTop_toTopOf="@+id/directorInfoKey" />

            <TextView
                android:id="@+id/directorInfoValue"
                style="@style/ShowMoreDialogValueTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/directorInfoKeyValueSeparator"
                app:layout_constraintTop_toTopOf="@+id/directorInfoKey"
                tools:text="M. Night Shyamalan, Test Test Test Test Test, Test Test Test Test Test Test Test Test Test Test Test Test test Test M. Night Shyamalan, Test Test Test Test Test, Test Test Test Test Test Test Test Test Test Test Test Test test Test M. Night Shyamalan, Test Test Test Test Test, Test Test Test Test Test Test Test Test Test Test Test Test test Test" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/directorInfoGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="directorInfoKey,directorInfoKeyValueSeparator,directorInfoValue"
                tools:contentDescription="@string/visibility_warning" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/directorInfoBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="directorInfoKey,directorInfoKeyValueSeparator,directorInfoValue" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/closeIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="48dp"
        android:src="@drawable/ic_close_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
