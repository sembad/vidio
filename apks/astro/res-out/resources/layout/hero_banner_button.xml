<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:id="@+id/HeroBannerButton"
    app:cardCornerRadius="8dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/hero_banner_button_bg_gadient">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/hero_banner_button_icon"
            android:textSize="16dp"
            android:textColor="#ebebeb"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:paddingStart ="16dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/hero_banner_button_text"
            android:text="Watch"
            android:gravity="center_vertical"
            android:layout_toRightOf="@+id/hero_banner_button_icon"
            android:textSize="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:textColor="#ebebeb"
            />
    </RelativeLayout>

</androidx.cardview.widget.CardView>
