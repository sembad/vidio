<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/guestmode_popup_shadow"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="648dp"
    android:layout_height="wrap_content"
    android:id="@+id/alertDialog"
    android:elevation="8dp"
    android:background="@drawable/guestmode_login_popup_background"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="24dp"
    android:paddingBottom="16dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/popupHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textViewMessage"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/infoIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30dp"
            android:includeFontPadding="false"
            android:text="O" />

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Login to Start Watching"
            android:textColor="#EBEBEB"
            android:textSize="20sp"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical"/>

        <ImageView
            android:id="@+id/closeIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_close_icon"
             />

    </LinearLayout>


    <TextView
        android:id="@+id/textViewMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum."
        android:textColor="#B2ADAF"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/popupHeader" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/buttonGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="loginButton,subscribeButton"
        app:layout_constraintTop_toBottomOf="@id/textViewMessage" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:text="Login with Astro ID"
        android:background="@drawable/action_menu_button_background"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        style="@style/GuestLoginPopupDialogCTAButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/subscribeButton"
        app:layout_constraintTop_toBottomOf="@id/textViewMessage"
        android:foreground="@drawable/primary_button_ripple_animation" />

    <View
        android:id="@+id/dummyTopView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@+id/loginButton"
        app:layout_constraintTop_toTopOf="@+id/loginButton" />

    <ImageView
        android:id="@+id/topGlint"
        android:layout_width="52dp"
        android:layout_height="15dp"
        android:background="@drawable/cta_top_glint_nux"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@+id/dummyTopView"
        app:layout_constraintStart_toStartOf="@+id/dummyTopView"
        app:layout_constraintTop_toBottomOf="@+id/dummyTopView" />

    <View
        android:id="@+id/dummyBottomView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/loginButton"
        app:layout_constraintEnd_toEndOf="@+id/loginButton" />

    <ImageView
        android:id="@+id/bottomGlint"
        android:layout_width="52dp"
        android:layout_height="15dp"
        android:background="@drawable/cta_bottom_glint_nux"
        app:layout_constraintBottom_toBottomOf="@+id/dummyBottomView"
        app:layout_constraintEnd_toEndOf="@+id/dummyBottomView"
        app:layout_constraintTop_toBottomOf="@+id/dummyBottomView" />


    <Button
        android:id="@+id/subscribeButton"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="4dp"
        android:text="Subscribe to Astro"
        android:background="@drawable/astro_secondary_button_background"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        style="@style/GuestLoginPopupDialogCTAButtons"
        app:layout_constraintStart_toEndOf="@+id/loginButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewMessage"
        android:foreground="@drawable/secondary_buttons_ripple_animation" />


</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
