<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/full_screen_content_view"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <include
        android:id="@+id/full_content_tool_bar"
        layout="@layout/full_content_toolbar" />
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/full_content_tab_layout"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:layout_width="match_parent"
        app:tabGravity="start"
        app:tabMinWidth="20dp"
        app:tabIndicatorColor="#ebebeb"
        android:scrollbarTrackHorizontal="@id/full_content_tab_layout"
        app:tabIndicatorHeight="1dp"
        app:tabTextColor="#ebebeb"
        android:clipToPadding="false"
        app:tabPadding="0dp"
        android:paddingStart="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:tabMode="scrollable"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/full_content_tool_bar"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />
    <View
        android:id="@+id/full_content_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4DEBEBEB"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@id/full_content_tab_layout"/>


    <LinearLayout
        android:id="@+id/container_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/full_content_tab_layout">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/filterMenuContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
               >
                <RelativeLayout
                    android:id="@+id/filterlayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <RelativeLayout
                        android:id="@+id/spinnerButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                            android:id="@+id/filterMenuValueText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            tools:text="Too long Recommended Text"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:gravity="start|center_vertical"
                            android:ellipsize="end"
                            android:maxLines="1"/>
                    </RelativeLayout>
                    <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                        android:id="@+id/dropdownArrowIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"/>
                </RelativeLayout>

            </RelativeLayout>
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/full_content_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

    </LinearLayout>

    <com.cisco.veop.client.widgets.BottomBarNavigationView
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <include
        layout="@layout/no_content_available"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/full_content_tool_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
