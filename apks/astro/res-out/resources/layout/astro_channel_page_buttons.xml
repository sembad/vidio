<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="#0e1019">

    <include
        android:id="@+id/astroPrimaryButton"
        layout="@layout/astro_primary_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@+id/secondaryButton"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/secondaryButton"
        style="@style/SecondaryButtonTextStyle"
        android:layout_width="52dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/astro_secondary_button_background"
        android:foreground="@drawable/secondary_buttons_ripple_animation"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/astroPrimaryButton"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Pl" />



</androidx.constraintlayout.widget.ConstraintLayout>
