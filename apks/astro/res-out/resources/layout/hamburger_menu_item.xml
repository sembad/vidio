<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hamburger_menu_item_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hamburger_menu_item_height">


    <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
        android:id="@+id/menu_item_icon"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        tools:text="#"
        android:textSize="16dp"
        android:includeFontPadding="true"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:maxLines="1"
        android:supportsRtl="true"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/menu_item_text"/>

    <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
        android:id="@+id/menu_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Too long sample text to check if ellipsize is working or not"
        android:textSize="16dp"
        android:includeFontPadding="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:supportsRtl="true"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/menu_item_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/menu_item_submenu_image"/>

    <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
        android:id="@+id/menu_item_submenu_image"
        android:textSize="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="&gt;" />

    <View
        android:id="@+id/menu_item_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hamburger_divider_height"
        android:layout_marginStart="@dimen/hamburger_divider_layout_marginLeft"
        android:layout_marginEnd="@dimen/hamburger_divider_layout_marginLeft"
        android:background="#19ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
