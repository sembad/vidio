<?xml version="1.0" encoding="utf-8"?><!--
Metadata part of tile is presented in this layout. This is included in multiple layouts like
type type1 and hero banner tiles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tile_metadata1_title"
        tools:text="Title Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        android:layout_gravity="center_vertical|start"
        android:fadingEdgeLength="40dp"
        android:includeFontPadding="false"
        android:ellipsize="none"
        android:layout_marginEnd="8dp"
        android:singleLine="true"
        android:textColor="#B3EBEBEB"
        android:textSize="20sp"
        android:textAlignment="viewStart"/>

    <TextView
        android:id="@+id/tile_metadata1_second_line"
        tools:text="Secondary Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="40dp"
        android:requiresFadingEdge="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical|start"
        android:ellipsize="none"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:textColor="#B3EBEBEB"
        android:textSize="14dp"/>

    <LinearLayout
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:overScrollMode="never"
        android:layout_margin="0px"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/tile_metadata1_third_line"
            tools:text="00:10 - 02:30pm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical|start"
            android:layout_gravity="center_vertical|start"
            android:ellipsize="none"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textColor="#B3EBEBEB"
            android:layout_alignParentStart="true"
            android:textSize="12sp"
            android:textAlignment="viewStart"/>

        <TextView
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical|start"
            android:textColor="#BFFFFFFF"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="12sp"/>

    </LinearLayout>
</LinearLayout>
