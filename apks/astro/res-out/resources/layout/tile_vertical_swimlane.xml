<?xml version="1.0" encoding="utf-8"?>

<com.cisco.veop.sf_ui.ui_configuration.AstroCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile_vertical_swimlane_layout"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    android:elevation="0dp"
    android:layout_marginEnd="8dp"
    app:cardPreventCornerOverlap="false"
    android:background="@android:color/transparent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/tile_vertical_swimlane_layout_direct_child"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/tile_poster_gradient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tile_poster_gradient_height"
        android:layout_alignBottom="@id/tile_poster"
        android:background="@android:color/darker_gray"
        tools:ignore="MissingConstraints" />


    <TextView
        android:id="@+id/tile_event_default_text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tile_poster_height"
        android:textSize="@dimen/tile_poster_default_text_size"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="0.57"
        app:layout_constraintTop_toTopOf="@id/tile_poster"
        app:layout_constraintBottom_toBottomOf="@id/tile_poster"
        android:text="Random text"
        android:textColor="@android:color/darker_gray"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/tile_poster"
        android:layout_width="160dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/tile_item_label"
        style="@style/AssetLabelDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:lineSpacingMultiplier="1.17"
        android:textSize="10sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/tile_poster"
        app:layout_constraintStart_toStartOf="@+id/tile_poster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="1"
        tools:text="New Season"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tile_item_title"
        android:text="Knives Out "
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tile_poster"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="148dp"
        android:textColor="#bcbcbc"
        android:textSize="12sp"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>

</com.cisco.veop.sf_ui.ui_configuration.AstroCardView>
