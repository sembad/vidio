<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/moreChannelInfoContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="32dp"
    tools:background="#0e1019">


    <Button
        android:id="@+id/bottomSheetTopBar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/ic_bottom_sheet_button" />


    <androidx.core.widget.NestedScrollView
        android:id="@+id/moreChannelInfoNestedScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:scrollbarThumbVertical="@drawable/scrollbar_background"
        android:scrollbars="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/channelPageNumber"
                style="@style/RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="#b2adaf"
                android:textSize="18sp"
                android:visibility="visible"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="16dp"
                tools:text="411" />

            <View
                android:id="@+id/channelPageNumberAndLogoSeparator"
                android:layout_width="1.5dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:background="#b2adaf"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/channelPageNumber"
                app:layout_constraintStart_toEndOf="@+id/channelPageNumber"
                app:layout_constraintTop_toTopOf="@+id/channelPageNumber"
                app:layout_goneMarginTop="16dp"
                tools:text="18" />

            <ImageView
                android:id="@+id/channelPageLogo"
                android:layout_width="46dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/channelPageNumber"
                app:layout_constraintStart_toEndOf="@+id/channelPageNumberAndLogoSeparator"
                app:layout_constraintTop_toTopOf="@+id/channelPageNumber"
                app:layout_goneMarginStart="16dp"
                tools:src="@drawable/ic_close_icon"
                tools:text="HD" />

            <!--Above settings for Channel Logo will make it as wide as the parent allows,
    and up/down-scale as needed keeping aspect ratio-->

            <TextView
                android:id="@+id/channelEventSynopsis"
                style="@style/ChannelSynopsisTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="16dp"
                android:textSize="14sp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/channelPageNumberAndLogoSeparator"
                tools:text="A frightened, withdrawn Philadelphia boy who communicates with spirits seeks the help of a disheartened child psychologist. A frightened, withdrawn Philadelphia boy who communicates with spirits seeks the help of a disheartened child psychologist." />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/bottomSheetTopGradient"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:layout_marginTop="28dp"
        android:background="@drawable/bottom_sheet_top_gradient"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomSheetBottomGradient"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_sheet_bottom_gradient"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
