<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile_grid_swim_lane_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_poster_layout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:cardCornerRadius="@dimen/tile_grid_corner_radius"
        android:minWidth="@dimen/tile_grid_poster_width"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/tile_grid_poster_width"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/tile_poster"
                android:layout_width="@dimen/tile_grid_poster_width"
                android:layout_height="0dp"
                android:minWidth="@dimen/tile_grid_poster_width"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <View
                android:id="@+id/tile_poster_gradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignBottom="@id/tile_poster"
                android:background="@drawable/tile_poster_gradient"
                tools:ignore="MissingConstraints" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/grid_poster_mask_color"/>

            <ProgressBar
                android:id="@+id/tile_progress_bar"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_progress_bar_height"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/custom_progress_bar"
                android:progressBackgroundTint="#B3D8D8D8"
                android:progressTint="#e6007d"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:gravity="end"
                tools:ignore="MissingConstraints">

                <TextView
                    android:id="@+id/title_grid_record_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_toStartOf="@id/tile_asset_labels"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="@dimen/tile_grid_meta_data_top_margin"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    tools:visibility="visible"
                    tools:text="D"
                    android:textSize="25dp" />

                <TextView
                    android:id="@+id/tile_asset_labels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Random Text"
                    tools:visibility="visible"
                    android:textSize="10sp"
                    android:layout_alignParentRight="true"
                    android:lineSpacingMultiplier="1.17"
                    android:layout_marginTop= "8dp"
                    android:layout_marginEnd="4dp"
                    style="@style/AssetLabelDisplay" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/channel_logo_icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitStart"
        android:minHeight="@dimen/tile_channel_logo_height"
        android:maxHeight="@dimen/tile_channel_logo_height"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/card_view_poster_layout"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="@dimen/tile_grid_meta_data_top_margin"
        android:layout_marginLeft="@dimen/tile_grid_meta_data_left_margin" />

    <TextView
        android:id="@+id/tile_metadata1_title"
        tools:text="Title Text"
        android:layout_width="@dimen/tile_grid_meta_data_title_width"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        android:layout_gravity="center_vertical|start"
        app:layout_constraintTop_toBottomOf="@+id/channel_logo_icon"
        app:layout_constraintLeft_toRightOf="@+id/card_view_poster_layout"
        android:fadingEdgeLength="40dp"
        android:layout_marginLeft="@dimen/tile_grid_meta_data_left_margin"
        android:layout_marginTop="@dimen/tile_grid_meta_data_top_margin"
        android:ellipsize="none"
        android:singleLine="true"
        android:textColor="@color/tile_grid_meta_data_title_color"
        android:textSize="@dimen/tile_grid_meta_data_title_text_size"
        android:textAlignment="viewStart"/>

    <LinearLayout
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="@dimen/tile_grid_meta_data_title_width"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tile_metadata1_title"
        app:layout_constraintLeft_toRightOf="@+id/card_view_poster_layout"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:overScrollMode="never"
        android:layout_marginTop="@dimen/tile_grid_meta_data_top_margin"
        android:layout_marginLeft="@dimen/tile_grid_meta_data_left_margin">

        <TextView
            android:id="@+id/tile_metadata1_third_line"
            tools:text="00:10 - 02:30pm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical|start"
            android:layout_gravity="center_vertical|start"
            android:ellipsize="none"
            android:singleLine="true"
            android:textColor="#b2adaf"
            android:layout_alignParentStart="true"
            android:textSize="12sp"
            android:textAlignment="viewStart"/>

        <TextView
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical|start"
            android:textColor="#b2adaf"
            android:ellipsize="none"
            android:singleLine="true"
            android:textSize="12sp"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
