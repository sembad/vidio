<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/two_line_metadata_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:layout_height="150dp">

    <TextView
        android:id="@+id/itemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="none"
        android:fadingEdgeLength="@dimen/tile_item_first_line_metadata_fading_edge_length"
        android:fontFamily="sans-serif-medium"
        android:gravity="start"
        android:lineSpacingMultiplier="1.2"
        android:requiresFadingEdge="horizontal"
        android:shadowColor="@color/collection_swimlane_item_title_shadow_color"
        android:shadowDx="0.0"
        android:shadowDy="2.0"
        android:shadowRadius="4.0"
        android:singleLine="true"
        android:textColor="@color/tile_item_first_line_metadata_text_color"
        android:textSize="@dimen/tile_item_first_line_metadata_text_size_mobile"
        app:layout_constraintBottom_toTopOf="@+id/itemMetadataAnchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="This line will have too longggggggggggggggggggg title of the event" />

    <!-- Very Important Note : Text Size and styling of itemMetadataAnchor
         should exactly be like itemMetadata and it should always be visible    -->

    <com.cisco.veop.sf_ui.widgets.AlwaysVisibleTextView
        android:id="@+id/itemMetadataAnchor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metadata_top_margin"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/tile_item_second_line_metadata_text_color"
        android:textSize="@dimen/tile_item_second_line_metadata_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/itemTitle"
        app:layout_constraintTop_toBottomOf="@+id/itemTitle" />

    <TextView
        android:id="@+id/itemMetadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="none"
        android:fadingEdgeLength="20dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.2"
        android:requiresFadingEdge="horizontal"
        android:singleLine="true"
        android:textColor="@color/tile_item_second_line_metadata_text_color"
        android:textSize="@dimen/tile_item_second_line_metadata_text_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/itemMetadataAnchor"
        app:layout_constraintEnd_toStartOf="@+id/itemFirstIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/itemTitle"
        app:layout_constraintTop_toTopOf="@+id/itemMetadataAnchor"
        tools:text="Genres Blah Blah Blah Blah Blah Blah Blahhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/itemFirstIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="none"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.2"
        android:singleLine="true"
        android:textColor="@color/tile_item_second_line_metadata_text_color"
        android:textSize="@dimen/tile_item_second_line_metadata_text_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/itemMetadataAnchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemMetadata"
        app:layout_constraintTop_toTopOf="@+id/itemMetadataAnchor"
        app:layout_goneMarginTop="@dimen/tile_item_first_line_metadata_margin_bottom"
        android:layout_marginStart="@dimen/tile_item_margin_between_text_and_icons_in_second_line_metadata"
        app:layout_goneMarginStart="0dp"
        tools:text="Iconss"
        tools:visibility="visible" />

    <com.cisco.veop.sf_ui.widgets.AlwaysVisibleTextView
        android:id="@+id/itemLabelAnchor"
        style="@style/DummyAssetLabelDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.17"
        android:textSize="10sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/itemRecordStatusIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.2"
        android:singleLine="true"
        android:textSize="@dimen/hub_screen_item_record_icon_size"
        app:layout_constraintBottom_toBottomOf="@+id/itemLabel"
        app:layout_constraintEnd_toStartOf="@+id/itemLabel"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/itemLabel"
        app:layout_goneMarginEnd="0dp"
        tools:text="Icon"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/itemLabel"
        style="@style/AssetLabelDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.17"
        android:textSize="10sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/itemLabelAnchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemRecordStatusIcon"
        app:layout_constraintTop_toTopOf="@+id/itemLabelAnchor"
        tools:text="New Label Too Long Textttt Texttt textttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
