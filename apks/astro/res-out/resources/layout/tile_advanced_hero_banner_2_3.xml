<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile_advanced_hero_banner_2_3_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tile_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </ImageView>

    <View
        android:id="@+id/tile_poster_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tile_poster_gradient_no_radius"
        android:layout_alignBottom="@id/tile_poster"/>

    <TextView
        android:id="@+id/hero_banner_labels"
        style="@style/AssetLabelDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tile_grid_margin"
        android:lineSpacingMultiplier="1.17"
        android:textSize="10sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/tile_metadata1_title"
        app:layout_constraintEnd_toEndOf="@id/verticalGuideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Asset Labels Long Text To Check Fading Effect"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tile_metadata1_title"
        tools:text="Title Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        android:gravity="left|center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tile_metadata1_second_line"
        android:fadingEdgeLength="40dp"
        android:layout_marginStart="@dimen/tile_grid_margin"
        android:layout_marginEnd="@dimen/tile_grid_margin"
        android:singleLine="true"
        android:ellipsize="none"
        android:maxLines="2"
        android:shadowColor="@color/hero_banner_shadow_color"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:lineSpacingExtra="6sp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/tile_hero_banner_text_size"/>

    <TextView
        android:id="@+id/tile_metadata1_second_line"
        tools:text="Secondary Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="40dp"
        android:requiresFadingEdge="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/tile_metadata1_third_line_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_gravity="center_vertical|start"
        android:shadowColor="@color/hero_banner_shadow_color"
        android:layout_marginStart="@dimen/tile_grid_margin"
        android:layout_marginEnd="@dimen/tile_grid_margin"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:ellipsize="none"
        android:singleLine="true"
        android:textColor="@color/tile_grid_meta_data_title_color"
        android:textSize="16sp"/>

    <LinearLayout
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginStart="@dimen/tile_grid_margin"
        android:layout_marginEnd="@dimen/tile_grid_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="121dp"
        android:gravity="center_vertical"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/tile_metadata1_third_line"
            tools:text="00:10 - 02:30pm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical|start"
            android:layout_gravity="center_vertical|start"
            android:ellipsize="none"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textColor="@color/tile_third_line_metadata_color"
            android:layout_alignParentStart="true"
            android:shadowColor="@color/hero_banner_shadow_color"
            android:textSize="14sp"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:lineSpacingExtra="3sp"
            android:textAlignment="viewStart"/>

        <TextView
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical|start"
            android:textColor="@color/tile_third_line_metadata_color"
            android:ellipsize="none"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="14sp"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tile_metadata1_third_line_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/hero_banner_button" />

    </FrameLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verticalGuideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />


</androidx.constraintlayout.widget.ConstraintLayout>
