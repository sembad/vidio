<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/dropDownMenuItem">

    <TextView
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd = "true"
        android:layout_centerVertical="true"
        tools:text="USD 25000000000000000"
        />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart = "true"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="30dp"
        android:layout_toStartOf="@+id/price"
        tools:text="Too Longgggggggggggggggggggggggggggggggg Titleeeeeeeeeeee"
        />

    <TextView
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart = "true"
        android:layout_below="@+id/title"
        android:layout_marginBottom="30dp"
        android:layout_toStartOf="@+id/price"
        tools:text="Dummy infooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo"
        />

</RelativeLayout>

