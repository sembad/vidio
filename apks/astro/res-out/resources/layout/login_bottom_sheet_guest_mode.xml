<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <View
        android:id="@+id/moreOptionsTopBar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ic_bottom_sheet_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/loginToWatchTitle"
        style="@style/GuestModeBottomSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        tools:text="Login to Start Watching"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/moreOptionsTopBar"/>

    <TextView
        android:id="@+id/loginToWatchDescription"
        style="@style/GuestModeBottomSheetDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean euismod quam nec hendrerit efficitur. Sed lacus libero, euismod non malesuada sit amet, viverra non arcu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginToWatchTitle"/>

    <include
        android:id="@+id/astroPrimaryButton"
        layout="@layout/astro_primary_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/loginToWatchDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/secondaryButton"
        style="@style/GuestModeBottomSheetSecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/astro_secondary_button_background"
        android:foreground="@drawable/secondary_buttons_ripple_animation"
        android:visibility="visible"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/astroPrimaryButton"
        tools:text="Subscribe To Astro" />

</androidx.constraintlayout.widget.ConstraintLayout>
