<?xml version="1.0" encoding="utf-8"?><!--
    Genre tile layout used for genre swimlane data.
    -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile_genre_shop_in_shop_id"
    app:cardElevation="10dp"
    app:cardCornerRadius="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tile_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/tile_genre_poster_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tile_genre_poster_gradient"
        android:layout_alignBottom="@id/tile_poster"/>

    <TextView
        android:id="@+id/tile_poster_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:ellipsize="end"
        android:maxLines="2"/>

</androidx.cardview.widget.CardView>
