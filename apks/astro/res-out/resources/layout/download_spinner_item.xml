<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theDownloadItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/download_status_spinner_ripple"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    tools:background="@android:color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/iconsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.cisco.veop.client.kiott.customviews.DownloadStatusIcon2
            android:id="@+id/itemDownloadStatusIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:textColor="@color/on_selected_bottom_sheet_item_color"
            android:textSize="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/itemIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="D" />


        <TextView
            android:id="@+id/itemIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:textColor="@color/on_selected_bottom_sheet_item_color"
            android:textSize="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemDownloadStatusIcon"
            tools:text="D"
            tools:visibility="visible" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/itemText"
        style="@style/RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:lineSpacingMultiplier="1.375"
        android:textColor="@color/on_selected_bottom_sheet_item_color"
        android:textSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/itemDownloadStatusPercentage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/iconsContainer"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Too longgggggggggggggggggggggggggggggggggggggg text" />

    <TextView
        android:id="@+id/itemDownloadStatusPercentage"
        style="@style/RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="16dp"
        android:lineSpacingMultiplier="1.375"
        android:textColor="#b2adaf"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemText"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="25%"
        tools:textColor="@android:color/white"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/downloadItemBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iconsContainer, itemText, itemDownloadStatusPercentage" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="16dp"
        android:background="#474747"
        app:layout_constraintTop_toBottomOf="@+id/downloadItemBottomBarrier" />

    <!--    height of divider has been intentionally set using px units instead of dp units
    android:layout_height="1px"-->

</androidx.constraintlayout.widget.ConstraintLayout>
