<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/demoFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@+id/backgroundGradientInCaseOfMultipleTabs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_movies_page_translucent_overlay"
        android:layout_marginTop="@dimen/some_random_height_for_scrolling_animation" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profilesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clipToPadding="false"
        android:layout_marginTop="24dp"
        android:minHeight="1000dp"
        android:paddingTop="@dimen/some_random_height_for_scrolling_animation"
        android:paddingBottom="@dimen/some_random_height_for_scrolling_animation" />

</androidx.constraintlayout.widget.ConstraintLayout>

