<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/streaming_quality_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="17dp"
        android:minWidth="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/streamingQualityTypeTitle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/streamingQualityIconContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/streamingQualityIcon"
            android:layout_width="25dp"
            android:layout_height="14dp"
            android:gravity="center"
            android:textColor="#0e1019"
            android:textSize="10dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="SQ" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/streamingQualityType"
        style="@style/RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:lineSpacingMultiplier="1.375"
        android:textColor="#80EBEBEB"
        android:textSize="12sp"
        app:layout_constrainedWidth="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/streamingQualityIconContainer"
        app:layout_constraintEnd_toStartOf="@+id/selectedStreamingQualityIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Standard" />

        <TextView
            android:id="@+id/selectedStreamingQualityIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EBEBEB"
            android:textSize="12sp"
            android:visibility="visible"
            android:gravity="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="V" />
    </androidx.constraintlayout.widget.ConstraintLayout>
