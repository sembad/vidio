<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemParentLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/rectangular_ripple_animation"
    tools:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,360:540"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="#000000">

        <ImageView
            android:id="@+id/heroBannerImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/default_event_bitmap_vod_portrait"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/tile_poster_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignBottom="@+id/heroBannerImageView"
            android:background="@drawable/tile_poster_gradient_no_radius" />


        <TextView
            android:id="@+id/itemLabel"
            style="@style/AssetLabelDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.17"
            android:textSize="12sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/itemTitle"
            app:layout_constraintEnd_toEndOf="@id/verticalGuidelineForLabel"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="New Hero Banner Long Label Texttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/itemTitle"
            style="@style/PortraitHeroBannerItemTitleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/itemMetadataTopBarrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemLabel"
            tools:text="Game of Thrones Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/itemMetadataTopBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="itemMetadata, itemFirstIcon"
            app:layout_constraintBottom_toTopOf="@+id/itemMetadata"
            app:layout_constraintTop_toBottomOf="@+id/itemTitle" />


        <TextView
            android:id="@+id/itemMetadata"
            style="@style/PortraitHeroBannerItemMetadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/itemMetadataBottomBarrier"
            app:layout_constraintEnd_toStartOf="@+id/itemFirstIcon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/itemTitle"
            app:layout_constraintTop_toBottomOf="@+id/itemMetadataTopBarrier"
            tools:text="8 Seasons | 2018 | Action Test test test test test ttt tst testtttttttttttttttttttttttttttttttttttttttt"
            tools:visibility="visible" />


        <TextView
            android:id="@+id/itemFirstIcon"
            style="@style/RobotoBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#D8D8D8"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/itemMetadata"
            app:layout_constraintEnd_toEndOf="@+id/itemTitle"
            app:layout_constraintStart_toEndOf="@+id/itemMetadata"
            app:layout_constraintTop_toTopOf="@+id/itemMetadata"
            app:layout_goneMarginStart="0dp"
            app:layout_goneMarginTop="8dp"
            tools:text="High Definition : HDDDD"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/itemMetadataBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="itemMetadata, itemFirstIcon"
            app:layout_constraintBottom_toTopOf="@+id/emptySpaceAtBottom"
            app:layout_constraintTop_toBottomOf="@+id/itemMetadata" />

        <Space
            android:id="@+id/emptySpaceAtBottom"
            android:layout_width="0dp"
            android:layout_height="121dp"
            app:layout_constraintBottom_toBottomOf="parent" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/verticalGuidelineForLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
