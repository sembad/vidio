<?xml version="1.0" encoding="utf-8"?><!--
Metadata part of tile is presented in this layout. This is included in multiple layouts like
type type1 and hero banner tiles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/tile_hero_banner_metadata"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/hero_banner_labels"
            style="@style/AssetLabelDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.17"
            android:textSize="12sp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@id/verticalGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Asset Labels Long Text To Check Fading Effect"
            tools:visibility="visible"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/verticalGuideline"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tile_metadata1_title"
        tools:text="TMNT"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        android:layout_gravity="center_vertical|start"
        android:fadingEdgeLength="40dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:layout_marginEnd="8dp"
        android:singleLine="false"
        android:textColor="#EBEBEB"
        android:textSize="48dp"
        android:lineSpacingExtra="10dp"
        android:textAlignment="viewStart"/>

    <LinearLayout
        android:id="@+id/tile_metadata1_third_line_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:overScrollMode="never"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tile_metadata1_third_line"
            tools:text="00:10 - 02:30pm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:gravity="center_vertical|start"
            android:layout_gravity="center_vertical|start"
            android:ellipsize="none"
            android:singleLine="true"
            android:textColor="#B2ADAF"
            android:lineSpacingExtra="3dp"
            android:includeFontPadding="false"
            android:layout_alignParentStart="true"
            android:textSize="16dp"
            android:textAlignment="viewStart"/>
        <TextView
            android:id="@+id/tile_metadata1_icons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:textColor="#BFFFFFFF"
            android:lineSpacingExtra="3dp"
            android:includeFontPadding="false"
            android:ellipsize="none"
            android:singleLine="true"
            android:textSize="12sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tile_metadata_synopsis"
        tools:text="Secondary Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="40dp"
        android:requiresFadingEdge="horizontal"
        android:gravity="center_vertical|start"
        android:layout_gravity="center_vertical|start"
        android:ellipsize="none"
        android:singleLine="false"
        android:maxLines="3"
        android:textColor="#EBEBEB"
        android:textSize="16dp"
        android:lineSpacingExtra="6dp"
        android:textAlignment="viewStart"
        android:layout_marginTop="16dp"/>

    <include layout="@layout/hero_banner_button"
        android:visibility="gone"
        android:id="@+id/hero_banner_button"/>

</LinearLayout>
