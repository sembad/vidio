<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false"
    tools:background="#0e1019">

    <include
        android:id="@+id/stationaryToolBar"
        layout="@layout/astro_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp" />

    <View
        android:id="@+id/mainPosterDummyPlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/channelNumberAndLogoTopBarrier"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stationaryToolBar" />

    <View
        android:id="@+id/topPartGradientTopAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginBottom="70dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@id/mainPosterDummyPlaceholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/topPartGradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/title_and_metadata_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topPartGradientTopAnchor" />


    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/channelNumberAndLogoTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="channelPageNumber, channelPageNumberAndLogoSeparator, channelPageLogo" />


    <TextView
        android:id="@+id/channelPageNumber"
        style="@style/RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="#b2adaf"
        android:textSize="18sp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/watchInfoKey"
        app:layout_constraintEnd_toStartOf="@+id/channelPageNumberAndLogoSeparator"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainPosterDummyPlaceholder"
        app:layout_goneMarginStart="16dp"
        tools:text="411" />

    <View
        android:id="@+id/channelPageNumberAndLogoSeparator"
        android:layout_width="1.5dp"
        android:layout_height="32dp"
        android:layout_marginEnd="18dp"
        android:background="#b2adaf"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/channelPageNumber"
        app:layout_constraintEnd_toStartOf="@+id/channelPageLogo"
        app:layout_constraintStart_toEndOf="@+id/channelPageNumber"
        app:layout_constraintTop_toTopOf="@+id/channelPageNumber"
        app:layout_goneMarginTop="16dp"
        tools:text="18" />

    <ImageView
        android:id="@+id/channelPageLogo"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/channelPageNumber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/channelPageNumberAndLogoSeparator"
        app:layout_constraintTop_toTopOf="@+id/channelPageNumber"
        app:layout_goneMarginStart="16dp"
        tools:src="@drawable/ic_close_icon"
        tools:text="HD" />

       <!--Above settings for Channel Logo will make it as wide as the parent allows,
       and up/down-scale as needed keeping aspect ratio-->

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/channelNumberAndLogoBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="channelPageNumber,channelPageNumberAndLogoSeparator, channelPageLogo" />


    <TextView
        android:id="@+id/watchInfoKey"
        style="@style/WatchInfoKeyTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoKeyValueSeparator"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/channelNumberAndLogoBottomBarrier"
        app:layout_goneMarginTop="16dp"
        tools:text="Now" />

    <TextView
        android:id="@+id/watchInfoKeyValueSeparator"
        style="@style/WatchInfoKeyTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":"
        app:layout_constraintBottom_toBottomOf="@+id/watchInfoKey"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoValue"
        app:layout_constraintStart_toEndOf="@+id/watchInfoKey"
        app:layout_constraintTop_toTopOf="@+id/watchInfoKey" />

    <TextView
        android:id="@+id/watchInfoValue"
        style="@style/WatchInfoValueTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/watchInfoKeyValueSeparator"
        app:layout_constraintTop_toTopOf="@+id/watchInfoKey"
        tools:text="S1 | EP1 Test Test Test Test | Test Test Test Test" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/watchInfoGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="watchInfoKey,watchInfoKeyValueSeparator,watchInfoValue"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
