<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collection_swimlane_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/collection_swimlane_layout_height_mobile"
    android:layout_marginBottom="@dimen/collection_swimlane_layout_bottom_margin_mobile"
    android:foreground="@drawable/rectangular_ripple_animation"
    tools:background="#000abc">

    <ImageView
        android:id="@+id/collectionSwimlanePoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/collection_swimlane_title"
        android:layout_width="@dimen/collection_swimlane_title_width_mobile"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/collection_swimlane_title_start_margin_mobile"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.34"
        android:maxLines="2"
        android:shadowColor="@color/collection_swimlane_title_shadow_color"
        android:shadowDx="0.0"
        android:shadowDy="2.0"
        android:shadowRadius="4.0"
        android:textColor="@color/collection_swimlane_title_color"
        android:textSize="@dimen/collection_swimlane_title_text_size_mobile"
        app:layout_constraintBottom_toTopOf="@+id/collection_swimlane_content_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="The Harry Potter Collection Too Long Title Too long Title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/collection_swimlane_content_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/coll_swim_scroll_view_start_padding"
        android:paddingEnd="@dimen/coll_swim_scroll_view_end_padding"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/collection_swimlane_title"
        app:layout_constraintHorizontal_bias="0"/>

</androidx.constraintlayout.widget.ConstraintLayout>
