<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false"
    android:paddingBottom="32dp"
    tools:background="@color/new_movies_page_bg_color">

    <TextView
        android:id="@+id/movieSynopsis"
        style="@style/MoviesSynopsisTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textSize="14sp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/castInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="16dp"
        tools:contentDescription="@string/visibility_warning"
        tools:text="A frightened, withdrawn Philadelphia boy who communicates with spirits seeks the help of a disheartened child psychologist. A frightened, withdrawn Philadelphia boy who communicates with spirits seeks the help of a disheartened child psychologist." />

    <TextView
        android:id="@+id/castInfo"
        style="@style/CastInfoValueTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:textSize="14sp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/directorInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/movieSynopsis"
        app:layout_goneMarginBottom="8dp"
        app:layout_goneMarginTop="0dp"
        tools:text="Cast: Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test  Test Test Test Test Test Test Test Test" />

    <TextView
        android:id="@+id/directorInfo"
        style="@style/DirectorInfoValueTextStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:textSize="14sp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/showMoreOrShowLessButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/castInfo"
        app:layout_goneMarginBottom="8dp"
        tools:text="Director: Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test" />

    <TextView
        android:id="@+id/showMoreOrShowLessButton"
        style="@style/ShowMoreTextStyleMobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Show More Or Less. After clicking Show More, all collapsed items will be expanded and vice-versa"
        android:text="@string/show_more_hint"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/directorInfo" />

</androidx.constraintlayout.widget.ConstraintLayout>
