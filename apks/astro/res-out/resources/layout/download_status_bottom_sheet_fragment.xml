<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/downloadStatusBottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    tools:background="@android:color/black">

    <Button
        android:id="@+id/topBar"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ic_bottom_sheet_button"
        app:layout_constraintBottom_toTopOf="@+id/firstItemText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <View
        android:id="@+id/firstItemView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/custom_ripple_for_more_option_bottom_sheet_item"
        app:layout_constraintBottom_toTopOf="@+id/firstItemBottomBarrier"
        app:layout_constraintTop_toTopOf="@+id/firstItemText" />


    <com.cisco.veop.client.kiott.customviews.DownloadStatusIcon2
        android:id="@+id/firstItemDownloadStatusIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/firstItemText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/firstItemText"
        tools:text="1"
        tools:textColor="@android:color/white" />

    <TextView
        android:id="@+id/firstItemText"
        style="@style/DownloadStatusBottomSheetFragmentTextViewStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:lineSpacingMultiplier="1.375"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textColor="@color/on_selected_bottom_sheet_item_color"
        android:textSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/firstItemBottomBarrier"
        app:layout_constraintEnd_toStartOf="@+id/firstItemDownloadStatusPercentage"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/firstItemDownloadStatusIcon"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        tools:text="First Item Too Longgggggggggggggggggggggggggggggggggg Textttttt " />


    <TextView
        android:id="@+id/firstItemDownloadStatusPercentage"
        style="@style/RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.5"
        android:lineSpacingMultiplier="1.375"
        android:textColor="#d8d8d8"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/firstItemText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/firstItemText"
        app:layout_constraintTop_toTopOf="@+id/firstItemText"
        tools:text="25%" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/firstItemBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="firstItemDownloadStatusIcon, firstItemText, firstItemDownloadStatusPercentage" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/firstItemGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="firstItemDownloadStatusIcon, firstItemText, firstItemDownloadStatusPercentage"
        tools:visibility="visible" />

    <View
        android:id="@+id/secondItemView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/custom_ripple_for_more_option_bottom_sheet_item"
        app:layout_constraintBottom_toTopOf="@+id/secondItemBottomBarrier"
        app:layout_constraintTop_toBottomOf="@+id/firstItemBottomBarrier" />

    <TextView
        android:id="@+id/secondItemIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/secondItemText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/secondItemText"
        tools:text="2"
        tools:textColor="@android:color/white" />

    <TextView
        android:id="@+id/secondItemText"
        style="@style/DownloadStatusBottomSheetFragmentTextViewStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:lineSpacingMultiplier="1.375"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textColor="@color/on_selected_bottom_sheet_item_color"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/secondItemIcon"
        app:layout_constraintTop_toBottomOf="@+id/firstItemBottomBarrier"
        tools:text="Second Item Texttttttttttttttttttttttttttttttttttttttttttttttttttttt" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/secondItemBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="secondItemIcon, secondItemText" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/secondItemGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="secondItemIcon, secondItemText"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/thirdItemIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/thirdItemText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/thirdItemText"
        tools:text="3"
        tools:textColor="@android:color/white" />

    <TextView
        android:id="@+id/thirdItemText"
        style="@style/DownloadStatusBottomSheetFragmentTextViewStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:lineSpacingMultiplier="1.375"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textColor="@color/on_selected_bottom_sheet_item_color"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/thirdItemIcon"
        app:layout_constraintTop_toBottomOf="@+id/secondItemBottomBarrier"
        tools:text="Third Item Texttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/thirdItemBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="thirdItemIcon, thirdItemText" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/thirdItemGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:constraint_referenced_ids="thirdItemIcon, thirdItemText" />

    <View
        android:id="@+id/thirdItemView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/custom_ripple_for_more_option_bottom_sheet_item"
        app:layout_constraintBottom_toTopOf="@+id/thirdItemBottomBarrier"
        app:layout_constraintTop_toBottomOf="@+id/secondItemBottomBarrier" />

</androidx.constraintlayout.widget.ConstraintLayout>
