<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemParentLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="#000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,1024:448"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="#000000">

        <com.exoplayer2.player.exoPlayerUi.HeroBannerPlayerView
            android:id="@+id/itemPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="270dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/trailerDimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/trailer_dimmer"
            android:visibility="visible" />

        <TextView
            android:id="@+id/itemLabel"
            style="@style/AssetLabelDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.17"
            android:textSize="12sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/itemTitle"
            app:layout_constraintEnd_toEndOf="@id/verticalGuidelineForLabel"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="New Hero Banner"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/itemTitle"
            style="@style/PremiumHeroBannerItemTitleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/itemMetadataTopBarrier"
            app:layout_constraintEnd_toEndOf="@id/verticalGuidelineForTitleAndSynopsis"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemLabel"
            tools:text="Game of Thrones Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test Test"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/itemMetadataTopBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="itemMetadata, itemParentalRatingIcon, itemResolutionIcon"
            app:layout_constraintBottom_toTopOf="@+id/itemSynopsis"
            app:layout_constraintTop_toTopOf="@+id/itemMetadata"  />

        <TextView
            android:id="@+id/itemMetadata"
            style="@style/PremiumHeroBannerItemMetadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toTopOf="@+id/itemMetadataBottomBarrier"
            app:layout_constraintEnd_toStartOf="@+id/itemParentalRatingIcon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/itemTitle"
            app:layout_constraintTop_toBottomOf="@+id/itemMetadataTopBarrier"
            app:layout_constraintVertical_bias="0"
            tools:text="8 Seasons | 2018 | Action, Drama | Test Test Test |  Test Test Test"
            app:layout_constrainedWidth="true"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/itemParentalRatingIcon"
            style="@style/RobotoBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#b2adaf"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_goneMarginEnd="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemMetadata"
            app:layout_constraintEnd_toStartOf="@+id/itemResolutionIcon"
            app:layout_constraintStart_toEndOf="@+id/itemMetadata"
            app:layout_constraintTop_toTopOf="@+id/itemMetadata"
            app:layout_goneMarginTop="8dp"
            tools:text="188888"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/itemResolutionIcon"
            style="@style/RobotoBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#b2adaf"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/itemMetadata"
            app:layout_constraintEnd_toEndOf="@id/verticalGuidelineForTitleAndSynopsis"
            app:layout_constraintStart_toEndOf="@+id/itemParentalRatingIcon"
            app:layout_constraintTop_toTopOf="@+id/itemMetadata"
            app:layout_goneMarginTop="8dp"
            app:layout_constrainedWidth="true"
            tools:text="HDDDDDDD"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/itemMetadataBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="itemMetadata,itemParentalRatingIcon, itemResolutionIcon"
            app:layout_constraintBottom_toTopOf="@+id/itemSynopsis"
            app:layout_constraintTop_toBottomOf="@+id/itemMetadata" />

        <!--    AlwaysVisibleTextView is a TextView which is always visible and
                if setVisibility(View.GONE) is called on this TextView,
                visibility will still be set to VISIBLE but text value will be set to an empty string
                If you are wondering why AlwaysVisibleTextView was used instead of TextView, try setting it to GONE
               in XML and see the result under DESIGN-->

        <com.cisco.veop.sf_ui.widgets.AlwaysVisibleTextView
            android:id="@+id/itemSynopsis"
            style="@style/PremiumHeroBannerItemSynopsisStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            app:layout_goneMarginTop="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/watchInfoButtonLayout"
            app:layout_constraintEnd_toEndOf="@id/verticalGuidelineForTitleAndSynopsis"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemMetadataBottomBarrier"
            tools:text="A fright who communicates with spirits seeks the help of a disheartened child psychologist. A frightened, withdrawn Philadelphia boy who communicates with spirits seeks the help of a disheartened child psychologist."
            tools:visibility="visible" />


        <include
            android:id="@+id/watchInfoButtonLayout"
            layout="@layout/astro_primary_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="78dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemSynopsis"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginTop="24dp"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/verticalGuidelineForLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/verticalGuidelineForTitleAndSynopsis"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.42" />

        <TextView
            android:id="@+id/muteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textSize="24sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="V"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/itemSpinner"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/muteButtonState"
        android:layout_width="2dp"
        android:layout_height="2dp"
        tools:text="DummyText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@android:color/transparent"
        tools:textColor="#ffffff"/>

</androidx.constraintlayout.widget.ConstraintLayout>
