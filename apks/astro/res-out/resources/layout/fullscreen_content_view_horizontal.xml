<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/full_screen_content_view"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:id="@+id/full_content_nav_bar"
        android:layout_height="wrap_content"
        android:minHeight="?android:attr/actionBarSize"
        app:buttonGravity="center_vertical"
        app:layout_constraintEnd_toEndOf="@+id/toolbar_tablayout_dropdown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/toolbar_tablayout_dropdown">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <LinearLayout
                android:id="@+id/toolbarBackButtonContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/full_content_toolbar_back_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    />

                <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                    android:id="@+id/full_content_toolbar_back_button_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp" />

            </LinearLayout>
            <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                android:id="@+id/full_content_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_toEndOf="@+id/toolbarBackButtonContainer"
                android:layout_toStartOf="@+id/toolbarSearchIconContainer"
                style="TextAppearance.AppCompat.Widget.ActionBar.Title"
                android:layout_centerInParent="true"
                android:gravity="center"
                />

            <RelativeLayout
                android:id="@+id/toolbarSearchIconContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true">


                <TextView
                    android:id="@+id/full_content_toolbar_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    />

            </RelativeLayout>

        </RelativeLayout>



    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar_tablayout_dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/full_content_nav_bar"
        android:gravity="end"
        android:layout_marginLeft="24dp"
        tools:ignore="MissingConstraints">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/full_content_tab_layout"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:layout_width="wrap_content"
            app:tabIndicatorColor="#ebebeb"
            app:tabTextColor="#ebebeb"
            android:scrollbarTrackHorizontal="@id/full_content_tab_layout"
            app:tabIndicatorHeight="1dp"
            android:clipToPadding="false"
            app:tabPadding="0dp"
            app:tabMinWidth="20dp"
            android:paddingStart="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:tabMode="scrollable"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints"/>



        <RelativeLayout
            android:id="@+id/filterMenuContainer"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent">

            <RelativeLayout
                android:id="@+id/filterlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="11dp"
                android:visibility="gone">


                <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                    android:id="@+id/filterHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Browse by" />

                <RelativeLayout
                    android:id="@+id/spinnerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_toRightOf="@+id/filterHeaderText">
                    <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                        android:id="@+id/filterMenuValueText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center|center_vertical"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Too long Recommended Text" />

                </RelativeLayout>

                <com.cisco.veop.sf_ui.ui_configuration.UiConfigTextView
                    android:id="@+id/dropdownArrowIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/spinnerButton"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/full_content_item_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4DEBEBEB"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/full_content_tab_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/container_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_tablayout_dropdown">



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/full_content_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />



    </LinearLayout>

    <com.cisco.veop.client.widgets.BottomBarNavigationView
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <include
        layout="@layout/no_content_available"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/full_content_nav_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
