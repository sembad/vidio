<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false"
    tools:background="#0e1019">


    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/channelNumberAndLogoTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="channelPageNumber, channelPageNumberAndLogoSeparator, channelPageLogo" />


    <TextView
        android:id="@+id/channelPageNumber"
        style="@style/RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="#b2adaf"
        android:textSize="18sp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/channelEventSynopsis"
        app:layout_constraintEnd_toStartOf="@+id/channelPageNumberAndLogoSeparator"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="16dp"
        tools:text="411" />

    <View
        android:id="@+id/channelPageNumberAndLogoSeparator"
        android:layout_width="1.5dp"
        android:layout_height="32dp"
        android:layout_marginEnd="18dp"
        android:background="#b2adaf"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/channelPageNumber"
        app:layout_constraintEnd_toStartOf="@+id/channelPageLogo"
        app:layout_constraintStart_toEndOf="@+id/channelPageNumber"
        app:layout_constraintTop_toTopOf="@+id/channelPageNumber"
        app:layout_goneMarginTop="16dp"
        tools:text="18" />

    <ImageView
        android:id="@+id/channelPageLogo"
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/channelPageNumber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/channelPageNumberAndLogoSeparator"
        app:layout_constraintTop_toTopOf="@+id/channelPageNumber"
        app:layout_goneMarginStart="16dp"
        tools:src="@drawable/ic_close_icon"
        tools:text="HD" />

       <!--Above settings for Channel Logo will make it as wide as the parent allows,
       and up/down-scale as needed keeping aspect ratio-->

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/channelNumberAndLogoBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="channelPageNumber,channelPageNumberAndLogoSeparator, channelPageLogo" />



    <TextView
        android:id="@+id/channelEventSynopsis"
        style="@style/SeriesSynopsisTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textSize="14sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/channelNumberAndLogoBottomBarrier"
        tools:contentDescription="@string/visibility_warning"
        tools:text="A frightened, withdrawn Philadelphia boy who communicates with spirits seeks the help of a disheartened child psychologist. A frightened, withdrawn Philadelphia boy who communicates with spirits seeks the help of a disheartened child psychologist." />


    <TextView
        android:id="@+id/watchInfoKey"
        style="@style/WatchInfoKeyTextStyleInTablets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/watchInfoTopBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/channelEventSynopsis"
        app:layout_goneMarginTop="16dp"
        tools:contentDescription="@string/visibility_warning"
        tools:text="Now On TV" />

    <!--    There is a top padding of 8dp in Zeplin for @+id/watchInfoKey .-->
    <!--    Refer to :  https://app.zeplin.io/project/6290a8197ef8ec11327b012c/screen/6358e5b0a1744e7fed20a08a-->

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/watchInfoTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="watchInfoValue, watchInfoRecordIcon, watchInfoRestartIcon,watchInfoParentalRatingIcon, watchInfoResolutionIcon" />

    <TextView
        android:id="@+id/watchInfoValue"
        style="@style/WatchInfoValueTextStyleInTablets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoRecordIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/watchInfoKey"
        tools:text="Winter is Coming | 12:40 P.M - 2:30 P.M" />

    <TextView
        android:id="@+id/watchInfoRecordIcon"
        style="@style/RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.5"
        android:textColor="#b2adaf"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/watchInfoValue"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoRestartIcon"
        app:layout_constraintStart_toEndOf="@+id/watchInfoValue"
        app:layout_constraintTop_toTopOf="@+id/watchInfoValue"
        app:layout_goneMarginTop="8dp"
        tools:text="RC" />

    <TextView
        android:id="@+id/watchInfoRestartIcon"
        style="@style/RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.5"
        android:textColor="#b2adaf"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/watchInfoValue"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoParentalRatingIcon"
        app:layout_constraintStart_toEndOf="@+id/watchInfoRecordIcon"
        app:layout_constraintTop_toTopOf="@+id/watchInfoValue"
        app:layout_goneMarginTop="8dp"
        tools:text="RE" />

    <TextView
        android:id="@+id/watchInfoParentalRatingIcon"
        style="@style/RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.5"
        android:textColor="#b2adaf"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/watchInfoValue"
        app:layout_constraintEnd_toStartOf="@+id/watchInfoResolutionIcon"
        app:layout_constraintStart_toEndOf="@+id/watchInfoRestartIcon"
        app:layout_constraintTop_toTopOf="@+id/watchInfoValue"
        app:layout_goneMarginTop="8dp"
        tools:text="18" />

    <TextView
        android:id="@+id/watchInfoResolutionIcon"
        style="@style/RobotoBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.5"
        android:textColor="#b2adaf"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/watchInfoValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/watchInfoParentalRatingIcon"
        app:layout_constraintTop_toTopOf="@+id/watchInfoValue"
        app:layout_goneMarginTop="8dp"
        tools:text="HD" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/watchInfoValueBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="watchInfoValue,watchInfoRecordIcon, watchInfoRestartIcon, watchInfoParentalRatingIcon, watchInfoResolutionIcon" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/watchInfoGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:constraint_referenced_ids="watchInfoKey,watchInfoValue,watchInfoRecordIcon,watchInfoRestartIcon" />



</androidx.constraintlayout.widget.ConstraintLayout>
