<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="#0e1019">

    <TextView
        android:id="@+id/itemTitle"
        style="@style/RobotoMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="2"
        android:textColor="#ebebeb"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/itemMetadataTopBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Winter is Coming. Winter is Coming. Winter is Coming. Winter is Coming. Winter is Coming. Winter is Coming. Winter is ComingWinter is Coming. Winter is Coming. Winter is Coming. Winter is ComingWinter is Coming. Winter is Coming. Winter is Coming. Winter is Coming. Winter is Coming. Winter is ComingWinter is Coming. Winter is Coming. Winter is Coming. Winter is Coming. Winter is ComingWinter is Coming. Winter is Coming. Winter is Coming. Winter is Coming" />


    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/itemMetadataTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="itemMetadata, itemParentalRatingIcon, itemResolutionIcon" />


    <TextView
        android:id="@+id/itemMetadata"
        style="@style/RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="#b2adaf"
        android:textSize="14sp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/itemParentalRatingIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemTitle"
        tools:text="S1 EP1 | 59 min" />

    <TextView
        android:id="@+id/itemParentalRatingIcon"
        style="@style/RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.5"
        android:textColor="#b2adaf"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/itemMetadata"
        app:layout_constraintEnd_toStartOf="@+id/itemResolutionIcon"
        app:layout_constraintStart_toEndOf="@+id/itemMetadata"
        app:layout_constraintTop_toTopOf="@+id/itemMetadata"
        app:layout_goneMarginTop="4dp"
        tools:text="18" />

    <TextView
        android:id="@+id/itemResolutionIcon"
        style="@style/RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.5"
        android:textColor="#b2adaf"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/itemMetadata"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemParentalRatingIcon"
        app:layout_constraintTop_toTopOf="@+id/itemMetadata"
        app:layout_goneMarginTop="4dp"
        tools:text="HD" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/itemMetadataBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="itemMetadata, itemParentalRatingIcon, itemResolutionIcon" />

</androidx.constraintlayout.widget.ConstraintLayout>
