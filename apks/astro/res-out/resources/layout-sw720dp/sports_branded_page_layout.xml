<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/brandingScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.cisco.veop.client.sportsBrandedPage.recyclerViews.SmartScrollRecyclerView
        android:id="@+id/verticalRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/branded_page_toolbar_height_in_negative"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="false"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/branded_page_toolbar_height"
            android:background="@drawable/branded_page_toolbar_background_expanded_state"
            android:minHeight="?attr/actionBarSize"
            android:visibility="visible"
            app:layout_scrollFlags="scroll|enterAlways">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/toolbarBackIcon"
                    style="@style/BrandedPageToolbarBackIconStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Back Icon"
                    tools:textSize="40sp" />


                <TextView
                    android:id="@+id/toolbarSearchIcon"
                    style="@style/BrandedPageToolbarSearchIconStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Search Icon"
                    tools:textSize="40sp" />

                <ImageView
                    android:id="@+id/brandLogo"
                    android:layout_width="@dimen/brand_logo_width"
                    android:layout_height="@dimen/brand_logo_height"
                    android:layout_marginStart="16dp"
                    android:adjustViewBounds="true"
                    android:gravity="start|center_vertical"
                    android:scaleType="fitStart"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/toolbarBackIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:layout_height="30.43dp"
                    tools:layout_width="136.88dp"
                    tools:src="@drawable/actionmenu_pip_lock"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/brandTitle"
                    style="@style/BrandTitleStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="start|center_vertical"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/toolbarSearchIcon"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/toolbarBackIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.43"
                    tools:text="Sports Branded Too Longgggg Titleeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/brandDimen"
                    style="@style/BrandTitleStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="80dp"
                    android:adjustViewBounds="true"
                    android:gravity="bottom"
                    app:layout_constraintStart_toEndOf="@+id/toolbarBackIcon"
                    android:visibility="gone"
                    android:background="#000000"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Size"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar
        android:id="@+id/progressLoader"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone"
        android:layout_gravity="center" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
