<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:animateLayoutChanges="false"
    tools:background="#0e1019">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ph_itemPosterCardView"
        android:layout_width="211dp"
        android:layout_height="119dp"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ph_itemPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@drawable/shimmer_effect_background_radius_8dp"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/ph_itemTitleAndMetadataLayout"
        layout="@layout/shimmer_placeholder_for_item_title_and_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="70dp"
        app:layout_constraintBottom_toTopOf="@+id/ph_itemSynopsis_Line1"
        app:layout_constraintEnd_toStartOf="@+id/ph_threeDotsIcon"
        app:layout_constraintStart_toEndOf="@+id/ph_itemPosterCardView"
        app:layout_constraintTop_toTopOf="@+id/ph_itemPosterCardView" />


    <TextView
        android:id="@+id/ph_itemSynopsis_Line1"
        style="@style/RobotoRegular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/shimmer_effect_background_radius_4dp"
        android:lineSpacingMultiplier="1.4"
        android:maxLines="1"
        android:textColor="#ebebeb"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/ph_itemSynopsis_Line2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ph_itemPosterCardView"
        app:layout_constraintTop_toBottomOf="@+id/ph_itemTitleAndMetadataLayout"
        tools:text="Test Test Test Test " />


    <TextView
        android:id="@+id/ph_itemSynopsis_Line2"
        style="@style/RobotoRegular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/shimmer_effect_background_radius_4dp"
        android:lineSpacingMultiplier="1.4"
        android:maxLines="1"
        android:textColor="#ebebeb"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ph_itemPosterCardView"
        app:layout_constraintTop_toBottomOf="@+id/ph_itemSynopsis_Line1"
        tools:text="Test Test Test Test " />

    <ImageView
        android:id="@+id/ph_threeDotsIcon"
        android:layout_width="22dp"
        android:layout_height="40dp"
        android:background="@drawable/shimmer_effect_background_radius_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ph_itemTitleAndMetadataLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ph_itemTitleAndMetadataLayout" />


</androidx.constraintlayout.widget.ConstraintLayout>
