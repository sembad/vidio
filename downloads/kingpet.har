ication/json","text":"{\"statusCode\":200,\"statusDesc\":\"Token is expaired\",\"statusText\":\"Token Kadaluarsa\",\"result\":{\"nightSessionConfig\":{\"title\":\"Sesi Malam\",\"sessionTitle\":\"Hasilkan Lebih Banyak <b>Saat Anda Tidur</b>\",\"sessionDescription\":\"<b>Ubahlah malam Anda menjadi keuntungan:</b><c> Dapatkan 2x</c> lebih banyak lagi saat Anda tidur dan bangun dengan<c> hadiah yang lebih besar</c> .\",\"chargeUpTitle\":\"<b>Isi daya</b> dan dapatkan 100% lebih banyak\",\"chargeUpDescription\":\"Jika Anda tetap <b>mengisi daya ponsel</b> Anda selama Sesi Malam, <b>penghasilan Anda akan meningkat secara otomatis sebesar</b><c> tambahan 100%</c>\",\"doubleEarningTitle\":\"Gandakan Penghasilan Anda\",\"doubleEarningDescription\":\"Selesaikan <b>Sesi Malam 5-jam</b> dan kami akan<c> menggandakan segalanya</c> Anda telah mendapatkan <b>bonus-bonus</b> di atas. Dan bagian terbaiknya? <b>Semuanya terjadi saat Anda tidur!</b>\",\"buttonText\":\"Sesi Malam\",\"buttonSubText\":\"Gandakan penghasilan Anda\",\"buttonSubWithAdLabelText\":\"Gandakan penghasilan Anda - Iklan diputar saat dimulai\",\"sessionPageDescription\":\"Selesaikan 5 jam dan gandakan hadiah Anda\",\"sessionEndMessage\":\"Yakin ingin menghentikan sesi sebelum menyelesaikan 5 jam? Jika ya, Anda akan kehilangan penghasilan tambahan sebesar 100%.\",\"sessionRewardMessage\":\"Kerja bagus! Sesi Anda telah selesai dan sebagai bonus, Anda mendapatkan 100% lebih banyak dari biasanya. Lanjutkan!\",\"earnedPercentage\":100,\"shouldShowNightSessionFeature\":true,\"shouldDialogCancelable\":false,\"shouldShowCloseIcon\":true,\"canStartNightSession\":true,\"sessionNotAvailableMessage\":\"Sesi malam saat ini tidak tersedia. Sesi akan tersedia dari 8:00 PM hingga 8:00 AM.\"},\"shouldShowOverlayMinimizeMode\":false,\"doubleRevenueConfig\":{\"isUserHaveDoubleRevenueFeature\":true,\"doubleRewardTaskList\":[{\"id\":\"1\",\"applicationId\":\"com.facebook.katana\",\"doubleRevenueViewType\":\"LARGE\",\"doubleRevenueFeatureImage\":\"\",\"doubleRevenueTitle\":\"Hasilkan 2X Lebih Banyak\",\"doubleRevenueSubTitle\":\"Dapatkan 2 Kali Lebih Mudah\",\"doubleRevenueFeatureType\":\"DOUBLE_REVENUE_DOWNLOAD_APP\",\"doubleRevenueProcessStatus\":\"completed\",\"doubleRevenueDescription\":\"Unduh Facebook untuk mendapatkan fitur eksklusif yang akan membantu Anda meningkatkan penghasilan dengan mudah.\",\"doubleRevenueButtonText\":\"Dapatkan Facebook\"},{\"id\":\"2\",\"applicationId\":\"\",\"doubleRevenueFeatureImage\":\"\",\"doubleRevenueViewType\":\"NORMAL\",\"doubleRevenueTitle\":\"program rujukan\",\"doubleRevenueFeatureType\":\"REFERRAL\",\"doubleRevenueProcessStatus\":\"processing\",\"doubleRevenueSubTitle\":\"dapatkan $0,10 secara instan ditambah 20%\",\"doubleRevenueDescription\":\"Rekomendasikan teman, dapatkan $0,10 secara instan, ditambah 20% dari penghasilan seumur hidup mereka. Bagikan dengan teman dan lihat penghasilan Anda bertambah!\",\"doubleRevenueButtonText\":\"Mulai merujuk\"},{\"id\":\"3\",\"applicationId\":\"\",\"doubleRevenueFeatureImage\":\"\",\"doubleRevenueViewType\":\"NORMAL\",\"doubleRevenueTitle\":\"Fitur Unduhan\",\"doubleRevenueProcessStatus\":\"processing\",\"doubleRevenueFeatureType\":\"DOWNLOAD_MONETIZATION\",\"doubleRevenueSubTitle\":\"\",\"doubleRevenueDescription\":\"Putar iklan dan unduh aplikasi dari iklan tersebut. Buka aplikasi dan bertahanlah di dalamnya selama minimal 2 menit, dan Anda akan menerima $0,02 dalam waktu 24 jam. Teruslah menghasilkan uang dengan aplikasi Givvy sambil mendapatkan penghasilan tambahan!\",\"doubleRevenueButtonText\":\"Hasilkan lebih banyak\"}]},\"appTransferConfig\":{\"title\":\"New app alert\",\"subTitle\":\"Kami mempersembahkan kepada Anda <b>aplikasi penghasil uang terbaru dan terbaik</b> kami\",\"description\":\"Unduh aplikasi baru kami <b>Robo Rally</b> dan tingkatkan <b>penghasilan Anda hingga 500%</b>\",\"appUrl\":\"https://play.google.com/store/apps/details?id=com.app.robo.rally.adventure\",\"applicationId\":\"com.app.robo.rally.adventure\",\"imageUrl\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/1752497221126_pandaEmpire.png\",\"moreEarningPercentage\":\"\",\"primaryButtonText\":\"Unduh Aplikasi\",\"secondaryButtonText\":\"Lewati & Lanjutkan\",\"shouldShowAppTransferFeature\":false,\"shouldSkipAndContinue\":true,\"shouldForceCloseApp\":false,\"shouldDialogCancellable\":true,\"shouldShowCloseButton\":true}}}"},"redirectURL":"","headersSize":779,"bodySize":4136,"_status":"completed","_startTimestamp":1790706571376119,"_endTimestamp":1790706571447402},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"54.243.129.215","connection":"172","comment":"","_id":175,"_uid":"d09fa96b-0405-4584-9aaa-4a6437d00cbe","_cid":172,"_ctime":1790706568151,"_sid":1,"_stime":1790706570773,"_serverAddress":"54.243.129.215","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":34924,"_app":{"name":"King’s Pets","id":"com.app.kings.pets.adventure"}},{"startedDateTime":"2026-09-29T18:29:28.034Z","time":1886,"request":{"method":"POST","url":"https://gw1.mediation.unity3d.com/auction?appKey=27837c43d&SDKVersion=8.7.0&initCountry=ID&platform=android&compressRequest=true&compressResponse=true","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Content-Type","value":"application/json; charset=utf-8"},{"name":"User-Agent","value":"Dalvik/2.1.0 (Linux; U; Android 10; M2006C3LG MIUI/V12.0.15.0.QCDIDXM)"},{"name":"Host","value":"gw1.mediation.unity3d.com"},{"name":"Connection","value":"Keep-Alive"},{"name":"Accept-Encoding","value":"gzip"},{"name":"Content-Length","value":"10280"}],"queryString":[{"name":"appKey","value":"27837c43d"},{"name":"SDKVersion","value":"8.7.0"},{"name":"initCountry","value":"ID"},{"name":"platform","value":"android"},{"name":"compressRequest","value":"true"},{"name":"compressResponse","value":"true"}],"postData":{"mimeType":"application/json","text":"{\"request\" : \"\"}"},"headersSize