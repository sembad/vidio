andakan penghasilan Anda\",\"buttonSubWithAdLabelText\":\"Gandakan penghasilan Anda - Iklan diputar saat dimulai\",\"sessionPageDescription\":\"Selesaikan 5 jam dan gandakan hadiah Anda\",\"sessionEndMessage\":\"Yakin ingin menghentikan sesi sebelum menyelesaikan 5 jam? Jika ya, Anda akan kehilangan penghasilan tambahan sebesar 100%.\",\"sessionRewardMessage\":\"Kerja bagus! Sesi Anda telah selesai dan sebagai bonus, Anda mendapatkan 100% lebih banyak dari biasanya. Lanjutkan!\",\"earnedPercentage\":100,\"shouldShowNightSessionFeature\":true,\"shouldDialogCancelable\":false,\"shouldShowCloseIcon\":true,\"canStartNightSession\":true,\"sessionNotAvailableMessage\":\"Sesi malam saat ini tidak tersedia. Sesi akan tersedia dari 8:00 PM hingga 8:00 AM.\"},\"shouldShowOverlayMinimizeMode\":false,\"doubleRevenueConfig\":{\"isUserHaveDoubleRevenueFeature\":true,\"doubleRewardTaskList\":[{\"id\":\"1\",\"applicationId\":\"com.facebook.katana\",\"doubleRevenueViewType\":\"LARGE\",\"doubleRevenueFeatureImage\":\"\",\"doubleRevenueTitle\":\"Hasilkan 2X Lebih Banyak\",\"doubleRevenueSubTitle\":\"Dapatkan 2 Kali Lebih Mudah\",\"doubleRevenueFeatureType\":\"DOUBLE_REVENUE_DOWNLOAD_APP\",\"doubleRevenueProcessStatus\":\"completed\",\"doubleRevenueDescription\":\"Unduh Facebook untuk mendapatkan fitur eksklusif yang akan membantu Anda meningkatkan penghasilan dengan mudah.\",\"doubleRevenueButtonText\":\"Dapatkan Facebook\"},{\"id\":\"2\",\"applicationId\":\"\",\"doubleRevenueFeatureImage\":\"\",\"doubleRevenueViewType\":\"NORMAL\",\"doubleRevenueTitle\":\"program rujukan\",\"doubleRevenueFeatureType\":\"REFERRAL\",\"doubleRevenueProcessStatus\":\"processing\",\"doubleRevenueSubTitle\":\"dapatkan $0,10 secara instan ditambah 20%\",\"doubleRevenueDescription\":\"Rekomendasikan teman, dapatkan $0,10 secara instan, ditambah 20% dari penghasilan seumur hidup mereka. Bagikan dengan teman dan lihat penghasilan Anda bertambah!\",\"doubleRevenueButtonText\":\"Mulai merujuk\"},{\"id\":\"3\",\"applicationId\":\"\",\"doubleRevenueFeatureImage\":\"\",\"doubleRevenueViewType\":\"NORMAL\",\"doubleRevenueTitle\":\"Fitur Unduhan\",\"doubleRevenueProcessStatus\":\"processing\",\"doubleRevenueFeatureType\":\"DOWNLOAD_MONETIZATION\",\"doubleRevenueSubTitle\":\"\",\"doubleRevenueDescription\":\"Putar iklan dan unduh aplikasi dari iklan tersebut. Buka aplikasi dan bertahanlah di dalamnya selama minimal 2 menit, dan Anda akan menerima $0,02 dalam waktu 24 jam. Teruslah menghasilkan uang dengan aplikasi Givvy sambil mendapatkan penghasilan tambahan!\",\"doubleRevenueButtonText\":\"Hasilkan lebih banyak\"}]},\"appTransferConfig\":{\"title\":\"New app alert\",\"subTitle\":\"Kami mempersembahkan kepada Anda <b>aplikasi penghasil uang terbaru dan terbaik</b> kami\",\"description\":\"Unduh aplikasi baru kami <b>Robo Rally</b> dan tingkatkan <b>penghasilan Anda hingga 500%</b>\",\"appUrl\":\"https://play.google.com/store/apps/details?id=com.app.robo.rally.adventure\",\"applicationId\":\"com.app.robo.rally.adventure\",\"imageUrl\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/1752497221126_pandaEmpire.png\",\"moreEarningPercentage\":\"\",\"primaryButtonText\":\"Unduh Aplikasi\",\"secondaryButtonText\":\"Lewati & Lanjutkan\",\"shouldShowAppTransferFeature\":false,\"shouldSkipAndContinue\":true,\"shouldForceCloseApp\":false,\"shouldDialogCancellable\":true,\"shouldShowCloseButton\":true}}}"},"redirectURL":"","headersSize":787,"bodySize":4136,"_status":"completed","_startTimestamp":1790706546670392,"_endTimestamp":1790706546711467},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"54.243.129.215","connection":"102","comment":"","_id":95,"_uid":"e0e68703-f270-4c1e-93e9-0ea26ee93afb","_cid":102,"_ctime":1790706544497,"_sid":1,"_stime":1790706546125,"_serverAddress":"54.243.129.215","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":34576,"_app":{"name":"King’s Pets","id":"com.app.k