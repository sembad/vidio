rmButtonTextColors\":\"#FFFFFF\",\"getRewardForShareScreenBackgroundColors\":[\"#AE9AFF\",\"#6E59E6\"],\"getRewardForShareScreenVerifyButtonColors\":[\"#AE9AFF\",\"#6E59E6\"],\"getRewardForShareScreenTopShapeColors\":[\"#AE9AFF\",\"#6E59E6\"],\"getRewardForShareScreenTextColor\":\"#FFFFFF\",\"getRewardForShareScreenCodeFieldBackgroundColor\":\"#494C5A\",\"getRewardForShareScreenErrorLabelColor\":\"#D15684\",\"getRewardForShareScreenButtonTextColor\":\"#FFFFFF\",\"claimShareRewardButtonColor\":\"#FF7B97\",\"claimShareRewardNSeePaymentButtonBackgroundColor\":\"#C1334E\",\"verificationScreenBackgroundColors\":[\"#121720\",\"#121720\"],\"verificationScreenVerifyButtonColors\":[\"#AE9AFF\",\"#6E59E6\"],\"verificationScreenCircleShapeColors\":[\"#AE9AFF\",\"#6E59E6\"],\"verificationScreenTextColor\":\"#FFFFFF\",\"verificationScreenEmailFieldBackgroundColor\":\"#494C5A\",\"verificationScreenErrorLabelColor\":\"#D15684\",\"verificationScreenTitleText\":\"Verifikasi identitas Anda\",\"verificationScreenBodyText\":\"Untuk menarik dana, Anda harus terlebih dahulu memverifikasi identitas Anda. Kami telah mengirimkan kode verifikasi ke email yang Anda gunakan saat mendaftar di aplikasi.\",\"verificationScreenButtonTextColor\":\"#FFFFFF\",\"getRewardClaimDialogBackgroundColors\":[\"#AE9AFF\",\"#6E59E6\"],\"getRewardForShareDialogAccountBackgroundColor\":\"#494C5A\",\"getRewardForShareScreenAccountBackgroundColor\":\"#494C5A\",\"sharingRewardDialogTitle\":\"BERBAGI BERHASIL\",\"sharingRewardDialogDescription\":\"Selamat! Anda berhasil berbagi penarikan terakhir Anda. Jika Anda menandai halaman kami, kami akan merespons Anda dengan kode digit ke-8 yang dapat Anda gunakan untuk mengklaim hadiah Anda!\",\"sharingRewardDialogButtonText\":\"Hebat\",\"rewardReceiveDialogTitle\":\"IMBALAN DITERIMA!\",\"rewardReceiveDialogDescription\":\"Selamat! Anda menerima hadiah uang Anda untuk berbagi penarikan terakhir Anda di media sosial.\",\"rewardReceiveDialogButtonText\":\"Hebat\",\"closeButtonImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/closeButtonImage_givvyStream.png\",\"backButtonImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/backButtonImage_givvyStream.png\",\"bonusRewardBackgroundColor\":[\"#121720\",\"#121720\"],\"bonusRewardMainImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/1721035603392_magicWords.png\",\"bonusRewardTitleTextColor\":\"#FFFFFF\",\"bonusRewardSubTitleTextColor\":\"#EFEFF1\",\"bonusRewardBodyTextColor\":\"#797A87\",\"bonusRewardCodeFieldTextColor\":\"#FFFFFF\",\"bonusRewardInputCodeBackgroundColor\":[\"#494C5A\",\"#494C5A\"],\"bonusRewardInputCodeTextColor\":\"#FFFFFF\",\"bonusRewardInputCodeHintTextColor\":\"#797A87\",\"bonusRewardErrorTextColor\":\"#CE90FF\",\"bonusRewardSendButtonBackgroundColor\":[\"#AE9AFF\",\"#6E59E6\"],\"bonusRewardButtonTextColor\":\"#FFFFFF\",\"bonusRewardCloseImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/bonusRewardCloseImage_givvyStream.png\",\"bonusRewardDialogBackgroundColor\":[\"#2C3137\",\"#17191D\"],\"bonusRewardDialogMainImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/1721035603392_magicWords.png\",\"bonusRewardDialogCloseImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/bonusRewardDialogCloseImage_givvyStream.png\",\"bonusRewardDialogTitleTextColor\":\"#FFFFFF\",\"bonusRewardDialogBodyTextColor\":\"#797A87\",\"bonusRewardDialogRewardAmountTextColor\":\"#FFFFFF\",\"bonusRewardDialogButtonTextColor\":\"#FFFFFF\",\"bonusRewardDialogButtonBackgroundColor\":[\"#AE9AFF\",\"#6E59E6\"],\"supportPageLink\":\"https://givvy.net/support/login\",\"addProviderButton\":\"https://i.imgur.com/unkha8y.png\",\"okayButtonTextColor\":\"#FFFFFF\",\"cancelButtonTextColor\":\"#FFFFFF\",\"okayButtonColor\":\"#252433\",\"cancelButtonColor\":\"#252433\",\"faceTecScreenBodyText\":\"Untuk melakukan penarikan, Anda harus terlebih dahulu memverifikasi identitas Anda. Proses ini membantu kami memastikan bahwa hanya Anda yang memiliki akses ke akun Anda dan melindungi informasi pribadi Anda dari penggunaan yang tidak sah. Dengan cara ini, Anda dapat yakin bahwa hanya Anda yang memiliki akses ke uang Anda. Terima kasih!\",\"bonusRewardTitleText\":\"Hadiah Spesial\",\"bonusRewardSubTitleText\":\"Temukan kode dan menang\",\"bonusRewardBodyText\":\"Kini Anda berkesempatan memenangkan sejumlah hadiah spesial. Temukan kode yang dikirim ke email Anda atau disembunyikan di saluran media sosial kami (Facebook, Instagram, YouTube, atau TikTok). Ketik kode yang Anda temukan di kolom di bawah ini. Nikmati hadiah spesial Anda.\",\"bonusRewardCodeFieldText\":\"\",\"bonusRewardErrorText\":\"kode\",\"bonusRewardButtonText\":\"Kirim\",\"_id\":\"633a0add63b306854c189267\",\"appName\":\"kingsPets\",\"mainTextColor\":\"#FFFFFF\",\"secondaryTextColor\":\"#FFFFFF\",\"backgroundColor\":\"#121720\",\"providerInfoTextColor\":\"#FFFFFF\",\"seeTransactionButtonBackgroundColor\":\"#4D3DA9\",\"waitingTransactionImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/waitingTransactionImage_givvyStream.png\",\"failedTransactionImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/failedTransactionImage_givvyStream.png\",\"successTransactionImage\":\"https://company-images-7942c117a7be.herokuapp.com/getImage/successTransactionImage_givvyStream.png\",\"successWithdrawDialogBottomBackgroundColor\":\"#1C1B20\",\"instagramButtonColor\":\"#E64B81\",\"facebookButtonColor\":\"#4267B2\",\"shareButtonColor\":\"#E64B81\",\"__v\":0,\"paymentOptionBackgroundColor\":\"#494C5A\",\"lastTransactionCellBackgroundColor\":\"#2B2E36\",\"lastTransactionMainColor\":\"#FFFFFF\",\"lastTransactionSecondColor\":\"#FFFFFF\",\"needWhiteProviderImages\":true,\"paymentFieldsBackgroundColor\":\"#494C5A\",\"seeTransactionCellBackgroundColor\":\"#494C5A\",\"markedWithdrawnOptionColor\":\"#AE9AFF\",\"borderStyle\":\"#AE9AFF\",\"shareAndEarnRewardText\":\"Rekam video singkat (10–60 detik) untuk memberi tahu kami jumlah uang yang Anda tarik, seberapa cepat uang tersebut sampai, di mana Anda menerimanya, dan untuk apa Anda berencana menggunakannya. Kirimkan video Anda dan Anda akan berkesempatan <b>memenangkan $0,05!</b>\",\"earnAndRewardTitle\":\"Rekam & Dapatkan <b>$0,05</b>\"}}"},"redirectURL":"","headersSize":760,"bodySize":7991,"_status":"completed","_startTimestamp":1790706480725666,"_endTimestamp":1790706480733874},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"54.220.192.176","connection":"35","comment":"","_id":30,"_uid":"c233fdb6-957a-4967-81ef-80409df55492","_cid":35,"_ctime":1790706479357,"_sid":1,"_stime":1790706480325,"_serverAddress":"54.220.192.176","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":34216,"_app":{"name":"King’s Pets","id":"com.app.kings.pets.adventure"}},{"startedDateTime":"2026-09-29T18:27:56.614Z","time":144,"request":{"method":"POST","url":"https://infoevent.startappservice.com/infoevent/api/v1.0/info","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Cache-Control","value":"no-cache"},{"name":"Content-Type","value":"application/json"},{"name":"Content-Encoding","value":"gzip"},{"name":"Accept","value":"application/json;text/html;text/plain"},{"name":"Accept-Encoding","value":"gzip"},{"name":"User-Agent","value":"Dalvik/2.1.0 (Linux; U; Android 10; M2006C3LG MIUI/V12.0.15.0.QCDIDXM)"},{"name":"Accept-Language","value":"in_ID"},{"name":"device-id","value":"0"},{"name":"Content-Length","value":"572"},{"name":"Host","value":"infoevent.startappservice.com"},{"name":"Connection","value":"Keep-Alive"}],"queryString":[],"postData":{"mimeType":"application/json","text":"{\"os\":\"android\",\"sdkVersion\":\"5.1.0\",\"flavor\":\"1023\",\"packageId\":\"com.app.kings.pets.adventure\",\"installerPkg\":\"com.android.vending\",\"userAdvertisingId\":\"0\",\"advertisingIdSource\":\"\",\"duid\":\"4ce4073c-2cf8-4a31-8d5c-2be130d000fa\",\"model\":\"M20